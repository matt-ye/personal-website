---
/*
 * 26 個課程週次頁的動態路由。
 *
 * 遷移前：public/projects/family-investing-course/week-NN/index.html
 *         26 個手刻檔，每個自帶完整的 head 與 11.5 KB 的 <style>。
 * 遷移後：meta 在 src/data/courseWeekMeta.ts、內容在 src/data/course-weeks/，
 *         head 由 CourseWeekLayout 統一產生。
 *
 * 內容用 set:html 原樣輸出，一個字都不改——那些 <script> 是各週的互動
 * 計算機（複利、雪球、效率前緣、DCF 組裝台…），每支都不一樣。
 * 靜態產生時 set:html 是把字串寫進輸出的 HTML，不是瀏覽器端的 innerHTML，
 * 所以裡面的 <script> 會照常執行。
 */
import CourseWeekLayout from '../../../layouts/CourseWeekLayout.astro';
import { courseWeekMeta } from '../../../data/courseWeekMeta';

/* eager: true 讓內容在建置時就併進來——這些是靜態教材，
   沒有動態載入的必要，也避免 26 個額外的 chunk。 */
const fragments = import.meta.glob('../../../data/course-weeks/*.html', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;

export function getStaticPaths() {
  return courseWeekMeta.map((meta) => ({ params: { slug: meta.slug }, props: { meta } }));
}

const { meta } = Astro.props;

const key = Object.keys(fragments).find((p) => p.endsWith(`/${meta.slug}.html`));
/* 找不到片段就讓建置失敗——安靜輸出一個空白教材頁，比壞掉更難發現 */
if (!key) throw new Error(`找不到課程內容片段：src/data/course-weeks/${meta.slug}.html`);
const body = fragments[key];
---

<CourseWeekLayout meta={meta}>
  <Fragment set:html={body} />
</CourseWeekLayout>
