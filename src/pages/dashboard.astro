---
// 私人流量儀表板（unlisted：noindex、不進導覽列與 sitemap）。
// 資料來源：GitHub Actions 每 6 小時快照 → secret gist（見 docs/analytics-pipeline.md）。
// 資料網址由 Cloudflare Pages 環境變數注入，不寫死在 repo。
//
// 版型原則：每個「網站」（主站、捕夢網…）是一個標準區塊，由同一個 siteSectionHTML()
// 渲染——KPI → 趨勢 → 分佈 → 子頁面成效 → 事件/轉換。新站只要進 GA4_EXTRA_SITES
// config 就會自動長出完整區塊，不會再有兩邊漂移的問題。
// 各區無外框，以分隔線 + 大標題（.dash-source）區隔。
import BaseLayout from '../layouts/BaseLayout.astro';
import T from '../components/T.astro';

const DATA_BASE = import.meta.env.PUBLIC_ANALYTICS_DATA_BASE ?? '';
---
<BaseLayout title="Dashboard" description="流量儀表板（私人頁面）">
  <script slot="head" src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="container-wide">

    <section class="speeches-hero">
      <h1><T zh="流量" en="Site" /> <span class="accent-text"><T zh="儀表板" en="Dashboard" /></span></h1>
      <p class="subtitle" id="dash-updated"><T zh="每 6 小時更新的網站流量、轉換與專案數據。" en="Traffic, conversion, and project metrics, refreshed every 6 hours." /></p>
    </section>

    <div id="dash-state" class="data-loading"><T zh="資料載入中…" en="Loading data…" /></div>

    <div id="dash-main" style="display:none">

      <!-- 全域時間視窗：控制所有網站區塊與 Cloudflare（GitHub 區的 traffic 資料性質不適用） -->
      <div class="dash-window-row" id="win-chips">
        <button class="chip" data-win="d7"><T zh="7 天" en="7d" /></button>
        <button class="chip" data-win="d28"><T zh="28 天" en="28d" /></button>
        <button class="chip" data-win="d90"><T zh="90 天（季）" en="Quarter" /></button>
        <button class="chip" data-win="d180"><T zh="半年" en="6 months" /></button>
        <button class="chip" data-win="d365"><T zh="一年" en="1 year" /></button>
      </div>

      <!-- 手動更新：開 GitHub Run workflow 頁 + 即時輪詢執行進度（公開 API，零憑證） -->
      <div class="dash-refresh-row">
        <button class="chip" id="refresh-btn">↻ <T zh="立即更新資料" en="Refresh data now" /></button>
        <span class="dash-muted" id="refresh-status"></span>
      </div>
      <div class="dash-progress" id="refresh-progress" style="display:none"><div class="dash-progress-bar"></div></div>

      <!-- 網站區塊（主站 + GA4_EXTRA_SITES，共用渲染器動態生成） -->
      <div id="sites-root"></div>

      <!-- Cloudflare -->
      <section class="dash-source" id="sec-cf">
        <div class="dash-source-head">
          <span class="dash-source-title"><T zh="Cloudflare 邊緣" en="Cloudflare edge" /></span>
          <span class="dash-muted" id="cf-win"></span>
          <a class="dash-source-link" href="https://dash.cloudflare.com" target="_blank" rel="noopener">mattye.dev zone ↗</a>
        </div>
        <div class="dash-sec-body">
          <div class="bento-grid" id="cf-kpis"></div>
          <div class="year-chart-card">
            <div class="year-chart-head">
              <div>
                <div class="chart-card-title"><T zh="每日 requests 與 unique visitors" en="Daily requests &amp; unique visitors" /></div>
                <div class="year-peak" id="cf-peak">—</div>
              </div>
            </div>
            <div class="year-chart-wrap"><canvas id="chart-cf"></canvas></div>
          </div>
          <p class="dash-chart-note" id="cf-note" style="display:none"></p>
        </div>
        <div class="dash-note" style="display:none"></div>
      </section>

      <!-- GitHub 專案 -->
      <section class="dash-source" id="sec-gh">
        <div class="dash-source-head">
          <span class="dash-source-title"><T zh="GitHub 專案" en="GitHub projects" /></span>
          <span class="chart-badge" id="badge-repos"></span>
          <span class="dash-muted" id="gh-stars"></span>
        </div>
        <div class="dash-sec-body">
          <div class="orgs-filter-row" id="repo-tabs">
            <button class="chip active" data-tab="public"><T zh="公開作品" en="Public" /> <span id="count-public"></span></button>
            <button class="chip" data-tab="private"><T zh="私人" en="Private" /> <span id="count-private"></span></button>
          </div>
          <div class="dash-repos" id="repos-grid"></div>
        </div>
        <div class="dash-note" style="display:none"></div>
      </section>

      <p class="dash-footnote">
        <T
          zh="資料來源：GA4 Data API · Cloudflare GraphQL Analytics · GitHub REST API。每 6 小時更新；GA4 近 48 小時數據為暫定值。"
          en="Sources: GA4 Data API · Cloudflare GraphQL Analytics · GitHub REST API. Refreshed every 6 hours; GA4 figures for the last 48h are provisional."
        />
      </p>

    </div>
  </div>
</BaseLayout>

<script define:vars={{ DATA_BASE }}>
/* ── helpers（骨架沿用 speeches.astro）─────────────── */
const lang = () => document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'zh';
const L = (zh, en) => lang() === 'en' ? en : zh;
const PALETTE = ['#3b82f6','#22d3ee','#ff5dd9','#ffd166','#4ade80','#ff7a59','#c8b0ff','#8ee0ff','#ffb3ee'];
const hasChart = () => typeof Chart !== 'undefined';
let chartInstances = [];
let repoCharts = []; // repo sparkline 獨立管理：tab 切換只重繪 repo 區
function destroyCharts() {
  [...chartInstances, ...repoCharts].forEach(c => { try { c.destroy(); } catch (e) {} });
  chartInstances = [];
  repoCharts = [];
}

function countUp(el, finalVal, dur) {
  if (!el || isNaN(finalVal)) return;
  const fmt = finalVal >= 1000
    ? v => `${(v / 1000).toFixed(1)}K`
    : v => String(Math.round(v));
  const start = performance.now();
  const step = now => {
    const t = Math.min((now - start) / dur, 1);
    const ease = 1 - Math.pow(1 - t, 3);
    el.textContent = fmt(finalVal * ease);
    if (t < 1) requestAnimationFrame(step);
    else el.textContent = fmt(finalVal);
  };
  requestAnimationFrame(step);
}

const fmtNum = n => n >= 1000 ? `${(n / 1000).toFixed(1)}K` : String(n);
const fmtGB = bytes => `${(bytes / 1e9).toFixed(bytes >= 1e10 ? 0 : 1)} GB`;
const fmtDay = iso => iso.slice(5).replace('-', '/');
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

/* ── state ──────────────────────────────────────────── */
let summary = null;
let history = [];

/* 全域時間視窗 */
const WIN_DAYS = { d7: 7, d28: 28, d90: 90, d180: 180, d365: 365 };
const WIN_LABEL = {
  d7: ['近 7 天', 'last 7 days'],
  d28: ['近 28 天', 'last 28 days'],
  d90: ['近 90 天', 'last 90 days'],
  d180: ['近半年', 'last 6 months'],
  d365: ['近一年', 'last 12 months'],
};
let win = null;
try { win = localStorage.getItem('dash-win'); } catch (e) {}
if (!WIN_DAYS[win]) win = 'd28';
const winLabel = () => L(...WIN_LABEL[win]);

// schema v2：維度報表是「視窗 → 陣列」物件；v1 舊資料是單一陣列（28 天）。
// 舊資料只在 28 天視窗可用，其餘視窗回 null（區塊顯示「待資料更新」）。
const forWin = (field) => Array.isArray(field)
  ? (win === 'd28' ? field : null)
  : (field?.[win] ?? null);
const PENDING = () => `<div class="dash-note" style="display:block">${L('此視窗的資料將在下次資料更新後出現（Actions → analytics → Run workflow 可立即更新）。', 'Data for this window appears after the next pipeline run (trigger it via Actions → analytics → Run workflow).')}</div>`;

document.querySelectorAll('#win-chips .chip').forEach((btn) => {
  btn.classList.toggle('active', btn.dataset.win === win);
  btn.addEventListener('click', () => {
    win = btn.dataset.win;
    try { localStorage.setItem('dash-win', win); } catch (e) {}
    document.querySelectorAll('#win-chips .chip').forEach((b) => b.classList.toggle('active', b === btn));
    if (summary) renderAll();
  });
});

/* repo 雙 tab：公開作品（public + 有架站的 private）/ 私人 */
let repoTab = 'public';
const inPublicTab = (r) => !r.private || !!r.site;
document.querySelectorAll('#repo-tabs .chip').forEach((btn) => {
  btn.addEventListener('click', () => {
    repoTab = btn.dataset.tab;
    document.querySelectorAll('#repo-tabs .chip').forEach((b) => b.classList.toggle('active', b === btn));
    if (summary) renderRepos();
  });
});

/* 手動更新：開 GitHub Run workflow 頁 + 輪詢執行狀態。
   公開 repo 的 Actions API 不需憑證且允許 CORS——真正的觸發在 GitHub 頁面上按
   （token 不能放進靜態頁：*.pages.dev 網域不受 Access 保護，會直接外洩）。
   節流：15 秒輪詢一次、最多 5 分鐘（未登入 API 限額 60 次/小時）。 */
const GH_REPO = 'matt-ye/personal-website';
const WF_PAGE = `https://github.com/${GH_REPO}/actions/workflows/analytics.yml`;
const RUNS_API = `https://api.github.com/repos/${GH_REPO}/actions/workflows/analytics.yml/runs?per_page=1`;
let watching = false;

async function refetchData() {
  const base = DATA_BASE.replace(/\/+$/, '');
  const bust = Date.now();
  const [sRes, hRes] = await Promise.all([
    fetch(`${base}/summary.json?t=${bust}`),
    fetch(`${base}/history.ndjson?t=${bust}`),
  ]);
  if (sRes.ok) summary = await sRes.json();
  if (hRes.ok) history = (await hRes.text()).split('\n').filter(Boolean).map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);
  renderAll();
}

document.getElementById('refresh-btn')?.addEventListener('click', async () => {
  if (watching) return;
  watching = true;
  const btn = document.getElementById('refresh-btn');
  const status = document.getElementById('refresh-status');
  const bar = document.getElementById('refresh-progress');
  btn.disabled = true;
  bar.style.display = '';

  // 真・一鍵：先試同源的 dashboard-api worker（Access 保護、token 在 worker secrets）。
  // worker 未部署 / 非 mattye.dev 網域 / Access 未過 → 退回開 GitHub 頁面的流程。
  let oneClick = false;
  status.textContent = L('觸發中…', 'Triggering…');
  try {
    const r = await fetch('/api/dashboard/trigger', { method: 'POST' });
    if (r.ok) oneClick = !!(await r.json()).ok;
  } catch (e) { /* fallback below */ }
  if (oneClick) {
    status.textContent = L('已觸發，等待執行開始…', 'Triggered — waiting for the run to start…');
  } else {
    window.open(WF_PAGE, '_blank', 'noopener');
    status.textContent = L('已開啟 GitHub——按綠色「Run workflow」後回到這裡，進度會自動顯示', 'GitHub opened — hit the green “Run workflow” button there; progress shows here');
  }
  const started = Date.now();
  const stop = (msg) => { watching = false; btn.disabled = false; bar.style.display = 'none'; status.textContent = msg; };
  const tick = async () => {
    if (Date.now() - started > 5 * 60e3) return stop(L('5 分鐘內未偵測到完成的執行——可到 GitHub Actions 查看', 'No completed run within 5 minutes — check GitHub Actions'));
    try {
      const res = await fetch(RUNS_API);
      if (res.ok) {
        const run = (await res.json()).workflow_runs?.[0];
        // 只認按下按鈕之後建立的 run（容忍 2 分鐘時鐘偏差）
        if (run && new Date(run.created_at).getTime() > started - 2 * 60e3) {
          if (run.status === 'completed') {
            if (run.conclusion === 'success') {
              status.textContent = L('執行完成，正在載入新資料…', 'Run finished — loading fresh data…');
              await refetchData();
              return stop(L(`✓ 資料已更新（${new Date().toLocaleTimeString('zh-TW')}）`, `✓ Data refreshed (${new Date().toLocaleTimeString('en-US')})`));
            }
            return stop(L(`✗ 執行失敗（${run.conclusion}）——到 GitHub Actions 看 log`, `✗ Run failed (${run.conclusion}) — see GitHub Actions logs`));
          }
          status.textContent = `${run.status === 'queued' ? L('排隊中…', 'Queued…') : L('執行中…', 'Running…')} ${Math.round((Date.now() - started) / 1000)}s`;
        }
      }
    } catch (e) { /* 網路波動，下一輪再試 */ }
    setTimeout(tick, 15000);
  };
  setTimeout(tick, oneClick ? 4000 : 8000); // fallback 模式多留時間按 Run workflow
});

/* 註冊用戶：live 數（同源 worker，僅 mattye.dev + Access 通過時可用）。
   失敗無妨——卡片仍顯示 pipeline 快照。 */
let liveUserCount = null;
async function fetchLiveUsers() {
  const key = summary?.regUsers?.siteKey;
  if (!summary?.regUsers?.configured || !key) return;
  try {
    const r = await fetch('/api/dashboard/users');
    if (!r.ok) return;
    const j = await r.json();
    if (typeof j.count === 'number') {
      liveUserCount = j.count;
      const el = document.getElementById(`ru-num-${key}`);
      if (el) el.textContent = fmtNum(liveUserCount);
    }
  } catch (e) { /* 非 mattye.dev 或 worker 未部署 */ }
}

/* 視窗內新增的註冊數（history ru 快照差值） */
function regUsersDelta(key) {
  const rows = history.filter(r => r.ru?.[key] !== undefined);
  if (rows.length < 2) return null;
  const nowV = rows[rows.length - 1].ru[key];
  const cutoff = new Date(Date.now() - WIN_DAYS[win] * 864e5).toISOString().slice(0, 10);
  const base = [...rows].reverse().find(r => r.date <= cutoff) ?? rows[0];
  return nowV - base.ru[key];
}

/* ── init ───────────────────────────────────────────── */
async function init() {
  const state = document.getElementById('dash-state');
  if (!DATA_BASE) {
    state.className = 'data-error';
    state.innerHTML = L(
      '⚠️ 尚未設定資料來源。<br><small>請依 docs/analytics-pipeline.md 完成 pipeline 首跑，並在 Cloudflare Pages 設定 PUBLIC_ANALYTICS_DATA_BASE 環境變數。</small>',
      '⚠️ Data source not configured.<br><small>Run the pipeline once and set the PUBLIC_ANALYTICS_DATA_BASE env var on Cloudflare Pages (see docs/analytics-pipeline.md).</small>'
    );
    return;
  }
  try {
    const bust = new Date().toISOString().slice(0, 10).replace(/-/g, '');
    const base = DATA_BASE.replace(/\/+$/, '');
    const [sRes, hRes] = await Promise.all([
      fetch(`${base}/summary.json?t=${bust}`),
      fetch(`${base}/history.ndjson?t=${bust}`),
    ]);
    if (!sRes.ok) throw new Error(`summary HTTP ${sRes.status}`);
    summary = await sRes.json();
    if ((summary.schemaVersion ?? 0) > 2) throw new Error(`unknown schemaVersion ${summary.schemaVersion}`);
    history = hRes.ok
      ? (await hRes.text()).split('\n').filter(Boolean).map(l => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean)
      : [];
    state.style.display = 'none';
    document.getElementById('dash-main').style.display = '';
    renderAll();
    fetchLiveUsers();
  } catch (err) {
    state.className = 'data-error';
    state.innerHTML = `⚠️ ${L('資料尚未產生或載入失敗——pipeline 首次執行成功後才會有資料。', 'No data yet — it appears after the first successful pipeline run.')}<br><small>${esc(err.message)}</small>`;
    console.error('Dashboard data error:', err);
  }
}

/* ── section 容錯（CF / GitHub 用）──────────────────── */
function sectionOk(id, ok, msgZh, msgEn) {
  const sec = document.getElementById(id);
  if (!sec) return false;
  const body = sec.querySelector('.dash-sec-body');
  const note = sec.querySelector('.dash-note');
  body.style.display = ok ? '' : 'none';
  note.style.display = ok ? 'none' : '';
  if (!ok) note.textContent = L(msgZh, msgEn);
  return ok;
}
const NOT_CONFIGURED = ['此區資料來源尚未設定（見 docs/analytics-pipeline.md）。', 'This data source is not configured yet (see docs/analytics-pipeline.md).'];

/* ── render ─────────────────────────────────────────── */
function renderAll() {
  destroyCharts();
  if (hasChart()) {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    Chart.defaults.color = isDark ? '#8b93bf' : '#666666';
    Chart.defaults.font.family = "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif";
    Chart.defaults.font.size = 11;
    Chart.defaults.borderColor = isDark ? 'rgba(255,255,255,.05)' : 'rgba(0,0,0,.06)';
  }

  const updated = document.getElementById('dash-updated');
  if (summary.generatedAt && updated) {
    const dt = new Date(summary.generatedAt);
    updated.textContent = L(`資料更新於 ${dt.toLocaleString('zh-TW')}`, `Data updated ${dt.toLocaleString('en-US')}`);
  }

  renderSites();
  renderCf();
  renderRepos();
}

/* ══ 網站區塊（主站與其他站共用同一套渲染）═══════════ */

const EVENT_LABELS = {
  click_github: ['點擊 GitHub', 'GitHub clicks'],
  click_project: ['點擊專案', 'Project clicks'],
  click_contact: ['聯繫點擊', 'Contact clicks'],
  read_complete: ['文章完讀', 'Read completes'],
  donate_open: ['開啟贊助', 'Donate opens'],
  donate_start: ['送出贊助', 'Donate starts'],
};

const eventWin = (e) => e?.windows?.[win] ?? ({ d28: e?.d28, d90: e?.d90 })[win];

function siteBlocks() {
  const blocks = [];
  const ga = summary.ga4;
  blocks.push({
    key: 'main',
    name: L('個人網站', 'Personal site'),
    host: 'mattye.dev',
    site: 'https://mattye.dev',
    isMain: true,
    configured: !!(ga && ga.configured && ga.totals && !ga.error),
    error: ga?.error,
    data: ga ?? {},
  });
  for (const s of summary.ga4Sites ?? []) {
    blocks.push({
      key: s.key,
      name: L(s.label?.zh ?? s.key, s.label?.en ?? s.key),
      host: (s.site ?? '').replace(/^https?:\/\//, '').replace(/\/$/, ''),
      site: s.site,
      isMain: false,
      configured: !!(s.configured && s.totals && !s.error),
      error: s.error,
      data: s,
    });
  }
  return blocks;
}

const tile = (label, value, sub) => {
  const isNum = typeof value === 'number';
  return `
    <div class="bento-card">
      <div class="bento-card-label">${label}</div>
      <div class="bento-card-num"${isNum ? ` data-countup="${value}"` : ''}>${isNum ? '—' : (value ?? '—')}</div>
      <div class="bento-card-sub">${sub}</div>
    </div>`;
};

// donut/bar 卡的標頭數字（最大項 + 類別數）在 HTML 直接算好；圖表另在 charts pass 建
const breakdownMeta = (list, val) => {
  if (!list?.length) return { biggest: '—', badge: '0' };
  const total = list.reduce((s, x) => s + val(x), 0) || 1;
  return { biggest: `${Object.values(list[0])[0]} · ${Math.round(val(list[0]) / total * 100)}%`, badge: String(list.length) };
};

function chartCard(title, canvasId, list, val) {
  const m = breakdownMeta(list, val);
  return `
    <div class="chart-card">
      <div class="chart-card-head"><span class="chart-card-title">${title}</span><span class="chart-badge">${m.badge}</span></div>
      <div class="chart-biggest">${m.biggest}</div>
      <div class="chart-wrap"><canvas id="${canvasId}"></canvas></div>
    </div>`;
}

function leaderboardHTML(pages) {
  if (!pages?.length) return `<div class="dash-note" style="display:block">${L('此視窗尚無頁面數據', 'No page data in this window yet')}</div>`;
  const top = pages.slice(0, 10);
  const max = top[0].views || 1;
  return `<div class="orgs-scroll-wrap"><div class="orgs-grid">` + top.map((p, i) => `
    <div class="org-row">
      <span class="org-rank${i < 3 ? ' org-rank-top' : ''}">${String(i + 1).padStart(2, '0')}</span>
      <span class="org-name">
        <span class="org-name-zh dash-path">${esc(p.path)}</span>
        <span class="org-name-en">${fmtNum(p.users ?? 0)} ${L('人', 'users')}${p.engagementSec ? ` · ${L('平均', 'avg')} ${Math.round(p.engagementSec / (p.views || 1))}s` : ''}</span>
      </span>
      <span class="org-bar-bg"><span class="org-bar" data-width="${(p.views / max) * 100}"></span></span>
      <span class="org-count">${fmtNum(p.views)}</span>
    </div>`).join('') + `</div></div>`;
}

function siteSectionHTML(b) {
  const head = `
    <div class="dash-source-head">
      <span class="dash-source-title">${esc(b.name)}</span>
      ${b.site ? `<a class="dash-source-link" href="${esc(b.site)}" target="_blank" rel="noopener">${esc(b.host)} ↗</a>` : ''}
    </div>`;

  if (!b.configured) {
    const msg = b.error
      ? `${L('本次抓取失敗:', 'Fetch failed: ')}${esc(b.error)}`
      : L('GA4 尚未設定（見 docs/analytics-pipeline.md）。', 'GA4 is not configured yet (see docs/analytics-pipeline.md).');
    return `<section class="dash-source">${head}<div class="dash-note" style="display:block">${msg}</div></section>`;
  }

  const d = b.data;
  const t = d.totals?.[win];

  /* KPI */
  let kpis =
    tile('Visitors', t?.users, winLabel()) +
    tile('Page Views', t?.views, winLabel()) +
    tile('Sessions', t?.sessions, t ? L(`新訪客 ${fmtNum(t.newUsers ?? 0)}`, `${fmtNum(t.newUsers ?? 0)} new`) : '—') +
    tile('Engagement', t ? `${Math.round((t.engagementRate ?? 0) * 100)}%` : null, L('互動率', 'Engagement rate'));
  if (b.isMain) {
    const reads = (d.events ?? []).find(e => e.name === 'read_complete');
    kpis += tile('Read Completes', eventWin(reads) ?? (reads ? null : undefined), L('文章完讀', 'Articles read'));
  }
  if (summary.regUsers?.configured && summary.regUsers.siteKey === b.key) {
    const count = liveUserCount ?? summary.regUsers.count;
    const delta = regUsersDelta(b.key);
    kpis += `
      <div class="bento-card">
        <div class="bento-card-label">Registered Users</div>
        <div class="bento-card-num" id="ru-num-${b.key}" data-countup="${count}">—</div>
        <div class="bento-card-sub">${L('註冊用戶', 'Registered users')}${delta !== null && delta > 0 ? ` · +${fmtNum(delta)} ${winLabel()}` : ''}</div>
      </div>`;
  }

  /* 趨勢 */
  const sliced = (d.daily ?? []).slice(-WIN_DAYS[win]);
  const peak = [...sliced].sort((a, x) => x.views - a.views)[0];
  const trend = `
    <div class="year-chart-card">
      <div class="year-chart-head">
        <div>
          <div class="chart-card-title">${L('流量趨勢', 'Traffic trend')} <span class="dash-muted">· ${winLabel()}</span></div>
          <div class="year-peak">${peak ? `Peak: ${fmtDay(peak.date)} · ${peak.views} views` : '—'}</div>
        </div>
      </div>
      <div class="year-chart-wrap"><canvas id="trend-${b.key}"></canvas></div>
      ${hasChart() ? '' : `<p class="dash-chart-note">${L('圖表元件載入失敗（CDN 無法連線），數字仍為正確資料。', 'Chart library failed to load; numbers are still accurate.')}</p>`}
    </div>`;

  /* 分佈（管道 / 裝置 / 站點(主站) / 國家）*/
  const channels = forWin(d.channels);
  const devices = forWin(d.devices);
  const hosts = b.isMain ? forWin(d.hosts) : null;
  const countries = forWin(d.countries);
  let breakdown;
  if (channels === null && devices === null && countries === null) {
    breakdown = PENDING();
  } else {
    breakdown = `<div class="charts-grid">`
      + chartCard(L('流量管道', 'Channels'), `ch-${b.key}`, channels, x => x.sessions)
      + chartCard(L('裝置', 'Devices'), `dev-${b.key}`, devices, x => x.users)
      + (hosts && hosts.length > 1 ? chartCard(L('站點', 'Sites'), `host-${b.key}`, hosts, x => x.users) : '')
      + chartCard(L('國家', 'Countries'), `geo-${b.key}`, countries, x => x.users)
      + `</div>`;
  }

  /* 子頁面成效 */
  const pages = forWin(d.topPages);
  const pagesHTML = `
    <p class="section-heading">${L('子頁面成效', 'Top pages')} <span class="dash-muted">· ${winLabel()}</span></p>
    ${pages === null ? PENDING() : leaderboardHTML(pages)}`;

  /* 事件 / 轉換 */
  let eventsHTML = '';
  if (b.isMain) {
    const events = d.events ?? [];
    const byName = Object.fromEntries(events.map(e => [e.name, e]));
    const cards = events.map(e => {
      const [zh, en] = EVENT_LABELS[e.name] ?? [e.name, e.name];
      const n = eventWin(e);
      const top = e.topPages?.[0];
      return `
        <div class="bento-card">
          <div class="bento-card-label">${esc(e.name)}</div>
          <div class="bento-card-num">${n === undefined ? '—' : fmtNum(n ?? 0)}</div>
          <div class="bento-card-sub">${L(zh, en)} · ${winLabel()}${top ? `<br><span class="dash-path">${esc(top.path)}</span>` : ''}</div>
        </div>`;
    }).join('');

    /* 漏斗（跟著視窗）*/
    const articleViews = (pages ?? []).filter(p => /^\/writing\/[^/]+/.test(p.path)).reduce((s, p) => s + p.views, 0);
    const projClicks = (eventWin(byName.click_project) ?? 0) + (eventWin(byName.click_github) ?? 0);
    const funnels = [
      { title: L('內容 → 專案', 'Content → Projects'), stages: [
        { label: L('文章瀏覽', 'Article views'), n: pages === null ? null : articleViews },
        { label: L('完讀', 'Read complete'), n: eventWin(byName.read_complete) ?? 0 },
        { label: L('點擊專案/GitHub', 'Project/GitHub click'), n: projClicks },
      ] },
      { title: L('贊助漏斗', 'Donation funnel'), stages: [
        { label: L('整站瀏覽', 'All page views'), n: t?.views ?? null },
        { label: L('開啟贊助', 'Donate open'), n: eventWin(byName.donate_open) ?? 0 },
        { label: L('送出贊助', 'Donate start'), n: eventWin(byName.donate_start) ?? 0 },
      ] },
    ];
    const funnelHTML = funnels.map(f => {
      if (f.stages[0].n === null) return `<div class="dash-funnel"><div class="dash-funnel-title">${f.title} <span class="dash-muted">· ${winLabel()}</span></div>${PENDING()}</div>`;
      const max = f.stages[0].n || 1;
      return `<div class="dash-funnel"><div class="dash-funnel-title">${f.title} <span class="dash-muted">· ${winLabel()}</span></div>` +
        f.stages.map((s, i) => {
          const pct = i === 0 ? '' : `<span class="dash-funnel-pct">${f.stages[i - 1].n ? Math.round(s.n / f.stages[i - 1].n * 100) : 0}%</span>`;
          return `<div class="dash-funnel-row">
            <span class="dash-funnel-label">${s.label}</span>
            <span class="org-bar-bg"><span class="org-bar" style="width:${Math.max(s.n / max * 100, s.n ? 2 : 0)}%"></span></span>
            <b class="dash-funnel-n">${fmtNum(s.n)}</b>${pct}
          </div>`;
        }).join('') + '</div>';
    }).join('');

    eventsHTML = `
      <p class="section-heading">${L('轉換', 'Conversions')} <span class="dash-muted">· ${winLabel()}</span></p>
      <div class="bento-grid">${cards}</div>
      <div class="dash-funnels">${funnelHTML}</div>`;
  } else {
    const evs = forWin(d.topEvents);
    const cards = evs === null ? PENDING() : (evs.length
      ? `<div class="bento-grid">` + evs.map(e => `
          <div class="bento-card">
            <div class="bento-card-label">${esc(e.name)}</div>
            <div class="bento-card-num" data-countup="${e.count}">—</div>
            <div class="bento-card-sub">${winLabel()}</div>
          </div>`).join('') + `</div>`
      : `<div class="dash-note" style="display:block">${L('此視窗尚無站方事件', 'No site events in this window yet')}</div>`);
    eventsHTML = `
      <p class="section-heading">${L('站方事件', 'Site events')} <span class="dash-muted">· ${winLabel()}</span></p>
      ${cards}`;
  }

  return `
    <section class="dash-source">
      ${head}
      <div class="bento-grid">${kpis}</div>
      ${trend}
      ${breakdown}
      ${pagesHTML}
      ${eventsHTML}
    </section>`;
}

const LINE_OPTS = {
  responsive: true, maintainAspectRatio: false,
  animation: { duration: 1000, easing: 'easeOutQuart' },
  interaction: { mode: 'index', intersect: false },
  plugins: { legend: { position: 'bottom', labels: { boxWidth: 8, boxHeight: 8, usePointStyle: true, pointStyle: 'circle' } } },
  scales: { x: { grid: { display: false }, ticks: { maxTicksLimit: 12 } }, y: { beginAtZero: true, ticks: { precision: 0 } } },
};

function donutChart(canvasId, entries, unit) {
  const el = document.getElementById(canvasId);
  if (!el || !entries?.length) return;
  const data = entries.filter(([, v]) => v > 0);
  if (!data.length) return;
  const total = data.reduce((s, [, v]) => s + v, 0);
  chartInstances.push(new Chart(el, {
    type: 'doughnut',
    data: {
      labels: data.map(([k]) => k),
      datasets: [{ data: data.map(([, v]) => v), backgroundColor: data.map((_, i) => PALETTE[i % PALETTE.length]), borderWidth: 0, borderRadius: 3, spacing: 1, hoverOffset: 8 }],
    },
    options: {
      cutout: '68%',
      responsive: true, maintainAspectRatio: false,
      animation: { duration: 1000, easing: 'easeOutQuart' },
      plugins: {
        legend: { position: 'bottom', labels: { boxWidth: 8, boxHeight: 8, padding: 8, font: { size: 11 }, usePointStyle: true, pointStyle: 'circle' } },
        tooltip: { callbacks: { label: c => ` ${c.label} · ${c.parsed} ${unit} (${(c.parsed / total * 100).toFixed(1)}%)` } },
      },
    },
  }));
}

function siteSectionCharts(b) {
  if (!hasChart()) return;
  const d = b.data;
  const sliced = (d.daily ?? []).slice(-WIN_DAYS[win]);
  const trendEl = document.getElementById(`trend-${b.key}`);
  if (trendEl && sliced.length) {
    chartInstances.push(new Chart(trendEl, {
      type: 'line',
      data: {
        labels: sliced.map(x => fmtDay(x.date)),
        datasets: [
          { label: 'Views', data: sliced.map(x => x.views), borderColor: PALETTE[0], backgroundColor: PALETTE[0] + '22', fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2 },
          { label: 'Visitors', data: sliced.map(x => x.users), borderColor: PALETTE[1], backgroundColor: 'transparent', tension: 0.35, pointRadius: 0, borderWidth: 2 },
        ],
      },
      options: LINE_OPTS,
    }));
  }

  donutChart(`ch-${b.key}`, (forWin(d.channels) ?? []).map(c => [c.channel, c.sessions]), 'sessions');
  donutChart(`dev-${b.key}`, (forWin(d.devices) ?? []).map(x => [x.device, x.users]), L('人', 'users'));
  if (b.isMain) donutChart(`host-${b.key}`, (forWin(d.hosts) ?? []).map(h => [h.host, h.users]), L('人', 'users'));

  const countries = (forWin(d.countries) ?? []).slice(0, 8);
  const geoEl = document.getElementById(`geo-${b.key}`);
  if (geoEl && countries.length) {
    chartInstances.push(new Chart(geoEl, {
      type: 'bar',
      data: {
        labels: countries.map(c => c.country),
        datasets: [{ data: countries.map(c => c.users), backgroundColor: countries.map((_, i) => PALETTE[i % PALETTE.length]), borderRadius: 4, borderSkipped: false, maxBarThickness: 16 }],
      },
      options: {
        indexAxis: 'y',
        responsive: true, maintainAspectRatio: false,
        animation: { duration: 1000, easing: 'easeOutQuart' },
        plugins: { legend: { display: false } },
        scales: { x: { beginAtZero: true, ticks: { precision: 0 } }, y: { grid: { display: false } } },
      },
    }));
  }
}

function renderSites() {
  const root = document.getElementById('sites-root');
  const blocks = siteBlocks();
  root.innerHTML = blocks.map(siteSectionHTML).join('');
  blocks.forEach(b => { if (b.configured) siteSectionCharts(b); });
  root.querySelectorAll('[data-countup]').forEach(el => countUp(el, Number(el.dataset.countup), 1400));
  requestAnimationFrame(() => requestAnimationFrame(() => {
    root.querySelectorAll('.org-bar[data-width]').forEach(el => { el.style.width = el.dataset.width + '%'; });
  }));
}

/* ══ Cloudflare（依視窗切 history；歷史從 pipeline 上線日開始累積）═══ */
function renderCf() {
  const cf = summary.cloudflare;
  const allCf = history.filter(r => r.cf);
  const ok = !!(cf && cf.configured && !cf.error) || allCf.length > 0;
  if (!sectionOk('sec-cf', ok, ...NOT_CONFIGURED)) return;

  const cfDays = allCf.slice(-WIN_DAYS[win]);
  document.getElementById('cf-win').textContent = `· ${winLabel()}`;
  const note = document.getElementById('cf-note');
  if (cfDays.length < WIN_DAYS[win]) {
    note.style.display = '';
    note.textContent = L(`Cloudflare 歷史自 pipeline 上線起累積，此視窗實際涵蓋 ${cfDays.length} 天。`, `Cloudflare history accumulates since the pipeline launch — this window covers ${cfDays.length} day(s).`);
  } else {
    note.style.display = 'none';
  }

  const sum = key => cfDays.reduce((s, r) => s + (r.cf[key] ?? 0), 0);
  const req = sum('req');
  const cached = sum('cachedReq');
  const tiles = [
    ['Requests', fmtNum(req), L(`${cfDays.length} 天邊緣請求`, `${cfDays.length}-day edge requests`)],
    ['Unique Visitors', fmtNum(sum('uniq')), L('每日 unique 加總', 'sum of daily uniques')],
    ['Cache Hit', req ? `${Math.round(cached / req * 100)}%` : '—', L('快取命中率', 'cache hit ratio')],
    ['Bandwidth', fmtGB(sum('bytes')), L('傳輸量', 'data served')],
  ];
  document.getElementById('cf-kpis').innerHTML = tiles.map(([label, num, sub]) => `
    <div class="bento-card">
      <div class="bento-card-label">${label}</div>
      <div class="bento-card-num">${num}</div>
      <div class="bento-card-sub">${sub}</div>
    </div>
  `).join('');

  const peak = [...cfDays].sort((a, b) => (b.cf.req ?? 0) - (a.cf.req ?? 0))[0];
  document.getElementById('cf-peak').textContent = peak ? `Peak: ${fmtDay(peak.date)} · ${fmtNum(peak.cf.req)} req` : '—';
  if (hasChart() && cfDays.length) {
    chartInstances.push(new Chart(document.getElementById('chart-cf'), {
      type: 'line',
      data: {
        labels: cfDays.map(r => fmtDay(r.date)),
        datasets: [
          { label: 'Requests', data: cfDays.map(r => r.cf.req ?? 0), borderColor: PALETTE[3], backgroundColor: PALETTE[3] + '22', fill: true, tension: 0.35, pointRadius: 0, borderWidth: 2 },
          { label: 'Uniques', data: cfDays.map(r => r.cf.uniq ?? 0), borderColor: PALETTE[4], backgroundColor: 'transparent', tension: 0.35, pointRadius: 0, borderWidth: 2 },
        ],
      },
      options: LINE_OPTS,
    }));
  }
}

/* ══ GitHub 專案 ═══════════════════════════════════════ */
function renderRepos() {
  const gh = summary.github;
  if (!sectionOk('sec-gh', !!(gh && gh.configured && gh.repos && !gh.error), ...NOT_CONFIGURED)) return;
  repoCharts.forEach(c => { try { c.destroy(); } catch (e) {} });
  repoCharts = [];

  const all = gh.repos ?? [];
  const pub = all.filter(inPublicTab);
  const priv = all.filter(r => !inPublicTab(r));
  const badge = document.getElementById('badge-repos');
  if (badge) badge.textContent = String(all.length);
  const stars = all.reduce((s, r) => s + (r.stars ?? 0), 0);
  document.getElementById('gh-stars').textContent = `★ ${fmtNum(stars)} ${L('顆星（全專案）', 'stars total')}`;
  document.getElementById('count-public').textContent = `(${pub.length})`;
  document.getElementById('count-private').textContent = `(${priv.length})`;

  // 排序：瀏覽數 desc → stars desc（無 traffic 數據者殿後）
  const list = (repoTab === 'public' ? pub : priv).slice().sort((a, b) =>
    ((b.views14?.count ?? -1) - (a.views14?.count ?? -1)) || ((b.stars ?? 0) - (a.stars ?? 0))
  );

  const grid = document.getElementById('repos-grid');
  grid.innerHTML = list.map((r, i) => {
    const name = L(r.label?.zh ?? r.repo.split('/')[1] ?? r.repo, r.label?.en ?? r.repo.split('/')[1] ?? r.repo);
    const traffic = r.views14
      ? `${L('瀏覽', 'Views')} <b>${fmtNum(r.views14.count)}</b> (${r.views14.uniques} uniq) · Clones <b>${fmtNum(r.clones14?.count ?? 0)}</b>`
      : `<span class="dash-muted">${esc(r.traffic?.error ?? r.error ?? L('無 traffic 數據', 'no traffic data'))}</span>`;
    const refs = (r.referrers ?? []).slice(0, 5).map(ref => `<span class="chip dash-ref">${esc(ref.referrer)} · ${ref.count}</span>`).join('');
    return `
      <div class="dash-repo-card">
        <div class="dash-repo-head">
          <a href="https://github.com/${esc(r.repo)}" target="_blank" rel="noopener">${r.private ? '🔒 ' : ''}${esc(name)}</a>
          ${r.site ? `<a class="dash-repo-site" href="${esc(r.site)}" target="_blank" rel="noopener">↗ site</a>` : ''}
        </div>
        ${r.description ? `<div class="dash-repo-desc">${esc(r.description)}</div>` : ''}
        <div class="dash-repo-stats">
          ★ <b>${r.stars ?? '—'}</b> · Forks <b>${r.forks ?? '—'}</b> · Issues <b>${r.openIssues ?? '—'}</b>
        </div>
        <div class="dash-repo-traffic">${traffic} <span class="dash-muted">· 14d</span></div>
        <div class="dash-spark-wrap"><canvas id="spark-${i}"></canvas></div>
        ${refs ? `<div class="dash-ref-chips">${refs}</div>` : ''}
      </div>
    `;
  }).join('');

  /* traffic sparkline（來自 history 累積，超越 14 天窗口） */
  if (!hasChart()) return;
  list.forEach((r, i) => {
    const days = history
      .filter(row => row.gh?.[r.repo]?.v !== undefined)
      .slice(-60)
      .map(row => ({ date: row.date, v: row.gh[r.repo].v }));
    if (days.length < 2) return;
    repoCharts.push(new Chart(document.getElementById(`spark-${i}`), {
      type: 'line',
      data: {
        labels: days.map(d => fmtDay(d.date)),
        datasets: [{ label: 'views', data: days.map(d => d.v), borderColor: PALETTE[i % PALETTE.length], backgroundColor: PALETTE[i % PALETTE.length] + '22', fill: true, tension: 0.4, pointRadius: 0, borderWidth: 1.5 }],
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        animation: false,
        plugins: { legend: { display: false }, tooltip: { intersect: false, mode: 'index' } },
        scales: { x: { display: false }, y: { display: false, beginAtZero: true } },
      },
    }));
  });
}

window.addEventListener('langchange', () => { if (summary) renderAll(); });
init();
</script>

<style is:global>
/* dashboard 專用樣式：JS 動態注入的節點吃不到 Astro scoped style，
   故以 .dash- 前綴 + is:global 隔離（僅 /dashboard 使用這些 class） */

/* 來源區塊：無外框，以分隔線 + 大標題區隔 */
