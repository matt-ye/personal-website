.dash-source-head { align-items: baseline; display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 20px; }
.dash-source-title { font-size: 1.35rem; font-weight: 700; letter-spacing: -0.01em; }
.dash-source-link { color: var(--color-text-muted); font-size: 0.82rem; }
.dash-source .section-heading { margin-top: 36px; }
.dash-source .year-chart-card, .dash-source .charts-grid { margin-top: 20px; }

.dash-note {
  background: var(--card-bg, var(--color-surface));
  border: 1px dashed var(--color-border);
  border-radius: var(--radius-md);
  color: var(--color-text-muted);
  font-size: 0.85rem;
  padding: 20px;
  text-align: center;
  margin-top: 8px;
}
.dash-chart-note { color: var(--color-text-muted); font-size: 0.75rem; padding: 8px 0; text-align: center; }
.dash-path { font-family: var(--font-mono); font-size: 0.85em; }
.dash-muted { color: var(--color-text-muted); font-size: 0.82rem; font-weight: 400; }
.dash-footnote { color: var(--color-text-muted); font-size: 0.78rem; margin: 48px 0 8px; text-align: center; }

.dash-window-row { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-bottom: 8px; }

.dash-refresh-row { align-items: center; display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin: 14px 0 4px; }
#refresh-btn:disabled { cursor: wait; opacity: 0.6; }
.dash-progress { background: var(--color-tag-bg, var(--color-surface)); border-radius: 999px; height: 4px; margin: 10px auto 0; max-width: 420px; overflow: hidden; }
.dash-progress-bar { animation: dash-indeterminate 1.4s ease-in-out infinite; background: var(--color-accent); border-radius: 999px; height: 100%; width: 40%; }
@keyframes dash-indeterminate { 0% { margin-left: -40%; } 100% { margin-left: 100%; } }

.dash-funnels { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; margin-top: 16px; }
.dash-funnel {
  background: var(--card-bg, var(--color-surface));
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 18px;
}
.dash-funnel-title { font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; }
.dash-funnel-row { align-items: center; display: flex; gap: 10px; margin-top: 10px; }
.dash-funnel-label { color: var(--color-text-muted); flex-shrink: 0; font-size: 0.78rem; width: 108px; }
.dash-funnel-n { font-variant-numeric: tabular-nums; min-width: 34px; text-align: right; }
.dash-funnel-pct { color: var(--color-accent); font-size: 0.75rem; min-width: 36px; text-align: right; }

.dash-repos { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin-top: 8px; }
.dash-repo-card {
  background: var(--card-bg, var(--color-surface));
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 18px;
}
.dash-repo-head { align-items: baseline; display: flex; gap: 10px; justify-content: space-between; }
.dash-repo-head > a { font-weight: 600; }
.dash-repo-desc { color: var(--color-text-muted); font-size: 0.8rem; margin-top: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.dash-repo-site { color: var(--color-text-muted); font-size: 0.78rem; white-space: nowrap; }
.dash-repo-stats { color: var(--color-text-muted); font-size: 0.82rem; margin-top: 8px; }
.dash-repo-stats b, .dash-repo-traffic b { color: var(--color-text); }
.dash-repo-traffic { color: var(--color-text-muted); font-size: 0.82rem; margin-top: 4px; }
.dash-spark-wrap { height: 56px; margin-top: 12px; position: relative; }
.dash-ref-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.dash-ref { cursor: default; font-size: 0.7rem; }
</style>
