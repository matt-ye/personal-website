---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { YMYL_SERIES } from '../../content.config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  /* 守衛：已知的 YMYL 系列裡，有沒有文章忘記填 `ymyl: true`。
     漏標的後果是財經文章少了免責聲明，而且沒有任何可見症狀——所以在這裡
     擋下來，讓 build 失敗好過安靜上線。新增財經系列時把 series 名稱加進
     content.config.ts 的 YMYL_SERIES。 */
  const missing = posts.filter(
    (p) => p.data.series && YMYL_SERIES.includes(p.data.series) && !p.data.ymyl,
  );
  if (missing.length > 0) {
    throw new Error(
      `這些文章屬於 YMYL 系列但沒填 ymyl: true，免責聲明不會輸出：\n` +
        missing.map((p) => `  - src/content/blog/${p.id}.md（series: ${p.data.series}）`).join('\n'),
    );
  }

  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  lang={post.data.lang}
  tags={post.data.tags}
  titleEn={post.data.titleEn}
  descriptionEn={post.data.descriptionEn}
  ymyl={post.data.ymyl}
>
  <Content />
</PostLayout>
