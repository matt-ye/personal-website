---
import BaseLayout from '../../../layouts/BaseLayout.astro';

/* 個人符號象徵頁。同時產出 /writing/symbolic-reminder/ 與
   /en/writing/symbolic-reminder/（i18n 遷移頁，見 [...lang]/about.astro）。

   遷移前這頁走 CSS 雙語機制（lang-zh/lang-en span）；拆頁後每個網址只
   渲染單一語言，英文從「斜體附註」升格為正文，不再用 em/muted 樣式。 */
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const isEn = Astro.currentLocale === 'en';
const t = (zh: string, en: string) => (isEn ? en : zh);

const IMG = '/images/symbolic-reminder';

/* 英文 description 自己數長度（L1-DESC-LONG 上限 160 字元） */
const descriptionZh =
  '從核心出發，層層構建十二層符號象徵 (symbol)，最終合為一，綜整「才幹」的定義與哲學格言紀錄。中英雙語。';
const descriptionEn =
  'Twelve layers of geometry, built from a single core into one symbol of competence — a personal philosophy shaped by OT training, Jung, and the Hero’s Journey.';

const opening = [
  {
    zh: '正中央的核心，代表著人的存在、人格和獨一無二的人生經歷。不論好壞，這是構成「你之所以是你，我之所以是我」的起點，一切從這裡開始。',
    en: 'At the very center is the core — a person’s existence, personality, and singular life experience. Good and bad alike, this is the starting point of “why you are you, and I am I.” Everything begins here.',
  },
  {
    zh: '這個符號的構想，大約是在我完成職能治療實習、大學畢業、考取國考證照，以及一年準備研究所考試的 Gap Year 間逐漸萌生。或許是因為學業、實習、國考、備考後的疲勞和倦怠，讓當時的我心中對人生充滿了疑問：「人為何要學習？人為何要提升能力？人為了什麼目標？」',
    en: 'The idea for this symbol took shape during my gap year — after finishing my occupational therapy internship, graduating, passing the national licensing exam, and spending a year preparing for graduate school. Perhaps it was the accumulated fatigue, but my mind was full of questions: Why do we learn? Why do we build ability? What are we aiming for?',
  },
  {
    zh: '在暫時脫離學生身分的這段時間，我嘗試收集資訊為自己解答。看遍閒書、勵志書、聽了幾千小時的 TED 演講與 Podcast 之後，從這些作者們的故事中我開始理解一件事：一個人學習的動機、獲得的能力還有設定的目標，是從願不願意正視自己的核心開始的——包括其中不喜歡的部分，像是缺點、負面經驗和創傷。',
    en: 'In that time outside the student role, I tried to answer them myself. After countless books and thousands of hours of TED talks and podcasts, one thing became clear from these authors’ stories: a person’s motivation to learn, the abilities they gain, and the goals they set all begin with whether they are willing to face their own core — including the parts they dislike: flaws, painful experiences, trauma.',
  },
  {
    zh: '我試圖把這個抽象理解畫出來，解構成由多個概念堆疊、交織的符號。這些概念來自職能治療訓練和延伸閱讀。其中，喬丹·彼得森（Jordan B. Peterson）的研究和著作幫助我逐漸釐清疑問——他的研究橫跨哲學、宗教、心理學與認知科學。從他的演講，我認識了榮格（Carl Jung）的分析心理學、人格面具（Persona）、陰影（Shadow）、個體化（Individuation），以及約瑟夫·坎伯（Joseph Campbell）的英雄之旅。這些理論的線索讓我不斷認識到：人不是避開困難或無視缺陷，而是先清楚看見、辨識、並解決它們，最終獲得相信自己能克服眼前問題與挑戰的信心和勝任力。',
    en: 'I tried to draw that abstract understanding — deconstructing it into a symbol built from stacked, interwoven concepts drawn from my OT training and further reading. Jordan B. Peterson’s work, spanning philosophy, religion, psychology, and cognitive science, helped me clarify these questions. Through his lectures I encountered Carl Jung’s analytical psychology — Persona, Shadow, Individuation — and Joseph Campbell’s Hero’s Journey. Their threads kept teaching me the same thing: we do not avoid difficulty or ignore our flaws; we see them clearly, name them, and resolve them — and in doing so gain the confidence and competence to face what is in front of us.',
  },
];

const witness = [
  {
    zh: '2019 年，我還是個準備成為職能治療師的實習生。OT 有個核心概念叫「治療性使用自身」（therapeutic use of self）——治療師本人，就是承載治療技術與知識的媒介。若運用得當，僅僅是治療師與人互動應答，都可能有療癒性。而自我覺察，是運用這個媒介的基本功。',
    en: 'In 2019, I was an intern preparing to become an occupational therapist. OT has a central concept called the therapeutic use of self — the therapist themselves is the medium that carries the technique and the knowledge. Used well, even the simple back-and-forth of interaction can be therapeutic. And self-awareness is the foundation of using that medium.',
  },
  {
    zh: '實習時，我逐漸發現自己有幾個潛藏的議題影響著表現，嚴重時甚至影響情緒穩定與睡眠。若誇飾地說，這些議題像是：失控的完美主義、嚴重低估自身能力、過度同理他人、過度討好他人。',
    en: 'During my internship, I gradually found several hidden issues affecting my performance — at their worst, my emotional stability and my sleep. To exaggerate only slightly, they looked like: runaway perfectionism, a severe underestimation of my own ability, over-empathizing, and over-pleasing.',
  },
  {
    zh: '在一個我將離家幾天的週五晚上，我留了一封信給爸媽，寫下糾結在腦海裡的念頭，嘗試釐清這些議題與家庭、成長經驗的關係。回家後，和父母聊了很久——聊他們眼中的我，聊那些我已經遺忘的童年趣事。那天我理解到：無論如何，父母會支持我。在失速的墜落中被接住的感覺，真好。回家的感覺，真好。',
    en: 'One Friday night, before leaving home for a few days, I left my parents a letter — writing down the thoughts tangled in my head, trying to trace these issues back to family and how I grew up. When I returned, we talked for a long time: about how they saw me, about childhood stories I had long forgotten. What I understood that day: no matter what, my parents would support me. Being caught mid-fall, when the fall feels unstoppable — that feels good. Coming home feels good.',
  },
];

interface TreeCell { img: string; alt: string; label: string; }
interface Block {
  label: string;
  img: string;
  alt: string;
  zh: string;
  en: string;
  /** 這格說明之後要放的疊合階層樹（上：結果，下：組成） */
  tree?: { aria: string; parent: TreeCell; children: TreeCell[] };
}

const blocks: Block[] = [
  {
    label: 'Core · Truth',
    img: `${IMG}/Core_Stain_Truth.svg`,
    alt: 'Core, Truth',
    zh: 'Core 英文原意表示「核」，也是勇氣（courage）的字根。這是一切的起點。人的核心，不論好壞，是個體之所以是個體的原因。而在核心之中，包含著榮格所說的 Shadow：那些人不願正視的面向——一個弱點、一個恐懼、一個難以接受的自我。看見並接納完整的核心，是生長出勇氣的第一步。',
    en: 'Core is also the root of the word courage. This is where everything begins. A person’s core — good and bad alike — is what makes an individual an individual. And within it lives what Jung called the Shadow: the aspects we refuse to see. A weakness. A fear. A self that is hard to accept. Seeing and accepting the whole core is the first step from which courage grows.',
  },
  {
    label: 'Circle of Arms · Embrace',
    img: `${IMG}/Circle_of_Arms.svg`,
    alt: 'Circle of Arms',
    zh: '看見核心之後，下一步是擁抱與接納——特別是那些陰影、弱點、恐懼，這些自己最不願正視的部分。圓圈象徵以雙臂擁抱圍繞自己的核心，告訴自己：「這些都是我，我不逃避，會勇敢直面。」',
    en: 'After seeing the core, the next step is to embrace and accept it — especially the shadow, the weaknesses, the fears we least want to face. The circle is a pair of arms wrapped around one’s own core, saying: “All of this is me. I will not run. I will face it.”',
  },
  {
    label: 'Vision · Embrace Weakness',
    img: `${IMG}/Vision_embrace_weakness.svg`,
    alt: 'Vision, Embrace Weakness',
    zh: '結合核心與雙臂環抱，組成瞳孔一般的圖形，代表一個更完整的視野——清楚看見自己的全部，包含那些你不喜歡的部分。看見弱點，才能超越弱點。',
    en: 'Core and embracing arms combine into a pupil-like form: a more complete vision that sees all of yourself, including the parts you dislike. Only by seeing a weakness can you transcend it.',
    tree: {
      aria: 'Vision 由 Core 與 Circle of Arms 疊合而成',
      parent: { img: `${IMG}/Vision_embrace_weakness.svg`, alt: 'Vision', label: 'Vision' },
      children: [
        { img: `${IMG}/Core_Stain_Truth.svg`, alt: 'Core', label: 'Core' },
        { img: `${IMG}/Circle_of_Arms.svg`, alt: 'Circle of Arms', label: 'Circle of Arms' },
      ],
    },
  },
  {
    label: 'Awareness · Intelligence',
    img: `${IMG}/Awareness_Intelligence.svg`,
    alt: 'Awareness, Intelligence',
    zh: '加入垂直線，分為對內和對外的視野。\n對內的視野，表示覺察力：看見內在思緒、情緒、感受，以正念為指引，止觀、思辨、表達。\n對外的視野，表示理解力：觀察外在事物、事件、資訊，以實證為基礎，學習、判斷、決策。',
    en: 'A vertical line divides vision into inward and outward.\nThe inward gaze is awareness: seeing one’s thoughts, emotions, and feelings, guided by mindfulness — observing, reasoning, expressing.\nThe outward gaze is intelligence: observing things, events, and information, grounded in evidence — learning, judging, deciding.',
  },
  {
    label: "Growth · Hero's Journey",
    img: `${IMG}/Growth_heros_journey.svg`,
    alt: "Growth, Hero's Journey",
    zh: '加入水平線，象徵日常與未知世界的分野，正如英雄之旅的故事模型概念圖。真正的成長，發生在人離開舒適圈、走入未知之後。這條水平線，也是舒適圈的邊界——離開舒適圈經歷試驗與磨難，克服危機、解決難題後，原有的未知成為日常，舒適圈擴大；英雄回歸日常，養精蓄銳，等待下一次冒險。',
    en: 'A horizontal line marks the boundary between the everyday and the unknown — the map of the Hero’s Journey. True growth happens after leaving the comfort zone and stepping into the unknown. Cross the line, endure the trials, overcome the crisis — and the unknown becomes the everyday; the comfort zone expands. The hero returns, rests, and waits for the next adventure.',
  },
  {
    label: 'Will · Choice · Aim',
    img: `${IMG}/Will_Choice_Aim.svg`,
    alt: 'Will, Choice, Aim',
    zh: '結合垂直與水平線，疊合兩層圓圈，形成十字準心，象徵選擇、目標和意志。在英雄之旅中，以清明覺察與深刻理解，選擇方向、設定目標，並勇往直行。這展現自我主動選擇的意志，而非被動地隨波逐流。',
    en: 'Vertical and horizontal lines combine with the two circles into a crosshair — choice, aim, and will. On the hero’s journey, with clear awareness and deep understanding, you choose a direction, set a goal, and go. This is the will that chooses, not the drift that follows.',
    tree: {
      aria: 'Will 由 Awareness 與 Growth 疊合而成',
      parent: { img: `${IMG}/Will_Choice_Aim.svg`, alt: 'Will', label: 'Will' },
      children: [
        { img: `${IMG}/Awareness_Intelligence.svg`, alt: 'Awareness', label: 'Awareness' },
        { img: `${IMG}/Growth_heros_journey.svg`, alt: 'Growth', label: 'Growth' },
      ],
    },
  },
  {
    label: 'Power · Sword',
    img: `${IMG}/Power_Sword.svg`,
    alt: 'Power, Sword',
    zh: '延伸垂直與水平線，形成利劍，象徵能量、能力、權力。',
    en: 'The lines extend into a sword — energy, ability, power.',
  },
  {
    label: 'Control · Sheath',
    img: `${IMG}/Control_Sheath.svg`,
    alt: 'Control, Sheath',
    zh: '以水平狹長的菱形，形成劍鞘，象徵包容、保護、自制。',
    en: 'A long horizontal diamond forms the sheath — containment, protection, restraint.',
  },
  {
    label: 'Meek · Virtue',
    img: `${IMG}/Meek_Virtue_control_the_power.svg`,
    alt: 'Meek, Virtue',
    zh: '結合利劍與劍鞘，表示入鞘之劍，象徵自制之德。Meek，在古英文中不是指「怯弱、溫柔」，而是「被控制的力量」。一個能控制自己力量的人，才真正擁有力量。真正的力量，不是揮劍不止，是知何時入鞘。武者不武，自制之德，是力量的展現，不是示弱。',
    en: 'Sword and sheath combine into the sheathed sword — the virtue of restraint. Meek, in its old meaning, is not timidity or softness but power under control. Only one who can control their power truly possesses it. True power is not endless wielding; it is knowing when to sheathe. Restraint is a display of strength, not of weakness.',
    tree: {
      aria: 'Meek 由 Sword 與 Sheath 疊合而成',
      parent: { img: `${IMG}/Meek_Virtue_control_the_power.svg`, alt: 'Meek', label: 'Meek' },
      children: [
        { img: `${IMG}/Power_Sword.svg`, alt: 'Sword', label: 'Sword' },
        { img: `${IMG}/Control_Sheath.svg`, alt: 'Sheath', label: 'Sheath' },
      ],
    },
  },
  {
    label: 'Mouth · Speech',
    img: `${IMG}/Mouth_speech.svg`,
    alt: 'Mouth, Speech',
    zh: '在菱形中延伸水平線，形成雙唇。言語和表達是個人力量的延伸，展現人能將混亂思緒梳理彙整，並清晰闡述。當人能以清晰的表達解決問題，便不需要訴諸肢體衝突。以表達力戰勝暴力，駕馭語言能賦予人真正的影響力。',
    en: 'A horizontal line through the diamond forms lips. Speech is an extension of personal power — the ability to order chaotic thought and state it clearly. When problems can be solved through clear expression, there is no need for physical conflict. Expression over violence: mastering language grants real influence.',
  },
  {
    label: 'Compass · Navigation',
    img: `${IMG}/Compass_Navigation.svg`,
    alt: 'Compass, Navigation',
    zh: '在菱形中延伸垂直線，形成指南針，象徵朝向目標的指引。在往目標前進的路程中，有時可能稍微偏離航線，而人只要能不斷修正、微調，最終仍可抵達目的地。',
    en: 'A vertical line through the diamond forms a compass — guidance toward the goal. On the way, you may drift slightly off course; as long as you keep correcting and adjusting, you will still arrive.',
  },
  {
    label: 'Wisdom Eye · Own the Vision',
    img: `${IMG}/Wisdom_eye_Own_the_vision.svg`,
    alt: 'Wisdom Eye, Own the Vision',
    zh: '結合劍鞘與視野圖形，組成智慧之眼。表示人能控制視野聚焦之處，知道應該看向何處，象徵智慧。盲目掃視容易被雜訊干擾；而將視野納入「鞘」中，表示人不再被動地接受外界資訊，而是能主動限縮、過濾雜訊，將有限的精力精準投入在最核心、最具價值的事物上。',
    en: 'Sheath and vision combine into the wisdom eye: the ability to control where vision focuses — to know where to look. An unguarded gaze is scattered by noise; a sheathed vision no longer passively receives, but actively narrows, filters, and invests its limited attention in what is most essential and most valuable.',
    tree: {
      aria: 'Wisdom Eye 由 Sheath 與 Vision 疊合而成',
      parent: { img: `${IMG}/Wisdom_eye_Own_the_vision.svg`, alt: 'Wisdom Eye', label: 'Wisdom Eye' },
      children: [
        { img: `${IMG}/Control_Sheath.svg`, alt: 'Sheath', label: 'Sheath' },
        { img: `${IMG}/Vision_embrace_weakness.svg`, alt: 'Vision', label: 'Vision' },
      ],
    },
  },
];

/* 結尾金字塔：位置即層級，無連線 */
const pyramid: TreeCell[][] = [
  [{ img: `${IMG}/Competence.svg`, alt: 'Competence', label: 'Competence' }],
  [
    { img: `${IMG}/Wisdom_eye_Own_the_vision.svg`, alt: 'Wisdom Eye', label: 'Wisdom Eye · Own the Vision' },
    { img: `${IMG}/Meek_Virtue_control_the_power.svg`, alt: 'Meek', label: 'Meek · Virtue' },
  ],
  [
    { img: `${IMG}/Will_Choice_Aim.svg`, alt: 'Will', label: 'Will · Choice · Aim' },
    { img: `${IMG}/Control_Sheath.svg`, alt: 'Sheath', label: 'Control · Sheath' },
    { img: `${IMG}/Power_Sword.svg`, alt: 'Sword', label: 'Power · Sword' },
  ],
  [
    { img: `${IMG}/Awareness_Intelligence.svg`, alt: 'Awareness', label: 'Awareness · Intelligence' },
    { img: `${IMG}/Growth_heros_journey.svg`, alt: 'Growth', label: "Growth · Hero's Journey" },
    { img: `${IMG}/Compass_Navigation.svg`, alt: 'Compass', label: 'Compass · Navigation' },
    { img: `${IMG}/Mouth_speech.svg`, alt: 'Mouth', label: 'Mouth · Speech' },
  ],
  [
    { img: `${IMG}/Vision_embrace_weakness.svg`, alt: 'Vision', label: 'Vision · Embrace Weakness' },
    { img: `${IMG}/Circle_of_Arms.svg`, alt: 'Circle of Arms', label: 'Circle of Arms · Embrace' },
    { img: `${IMG}/Core_Stain_Truth.svg`, alt: 'Core', label: 'Core · Truth' },
  ],
];
---
<BaseLayout
  title={isEn ? 'Symbolic Representation — Personal Maxims' : '我的格言符號象徵'}
  description={isEn ? descriptionEn : descriptionZh}
  lang={isEn ? 'en' : 'zh-TW'}
>
  <article class="manifesto">
    <a href={isEn ? '/en/writing/' : '/writing/'} class="back-link">← Writing</a>

    <header class="manifesto-header">
      <div class="post-meta">
        <time datetime="2026-06-25">Jun 25, 2026</time>
        <span class="tag">{t('哲學格言', 'Philosophical Maxims')}</span>
        <span class="tag">Personal Brand</span>
      </div>
      <h1 class="manifesto-title">{t('我的符號象徵', 'Symbolic Representation')}</h1>
      <p class="manifesto-subtitle">{t('個人格言', 'Personal Maxims')}</p>
    </header>

    <div class="symbol-hero">
      <img src={`${IMG}/Competence.svg`} alt="Competence — the complete symbol" class="symbol-img symbol-hero-img" />
    </div>
    <p class="hero-caption">{t('這是我想像中代表人的勝任力的完整符號象徵。以下，是它的十二層構成元素。', 'This is the complete symbol of competence as I imagine it. What follows are its twelve constituent layers.')}</p>

    <section class="declaration-opening">
      {opening.map((p) => <p>{t(p.zh, p.en)}</p>)}
      <p class="stack-decl">{t(
        '接下來的每個符號，都是從前一個幾何形狀衍生而來，說明著：「勝任力不是憑空出現的，是一層一層堆疊、建構而成。」',
        'Each symbol that follows derives from the geometry of the one before it, declaring: competence does not appear from nowhere — it is stacked and built, layer by layer.'
      )}</p>
    </section>

    <hr class="section-divider" />

    {blocks.map((b, i) => (
      <>
        <div class="symbol-block">
          <div class="symbol-label">{b.label}</div>
          <div class="symbol-content">
            <div class="symbol-text">
              <p class="symbol-desc">{t(b.zh, b.en)}</p>
            </div>
            <img src={b.img} alt={b.alt} class="symbol-img symbol-std" />
          </div>
        </div>

        {i === 0 && (
          <div class="witness">
            {witness.map((p) => <p>{t(p.zh, p.en)}</p>)}
            <p class="witness-coda">{t(
              '那是一次張開雙臂、擁抱自己核心的珍貴經驗。',
              'That was a precious experience of opening my arms and embracing my own core.'
            )}</p>
          </div>
        )}

        {b.tree && (
          <div class="mini-tree" aria-label={b.tree.aria}>
            <div class="mt-parent">
              <figure class="mt-cell">
                <img src={b.tree.parent.img} alt={b.tree.parent.alt} class="symbol-img" />
                <figcaption>{b.tree.parent.label}</figcaption>
              </figure>
            </div>
            <div class="mt-children">
              {b.tree.children.map((c) => (
                <figure class="mt-cell">
                  <img src={c.img} alt={c.alt} class="symbol-img" />
                  <figcaption>{c.label}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}
      </>
    ))}

    <hr class="section-divider" />

    <section class="declaration-closing">
      <div class="symbol-label competence-label">Competence</div>

      <div class="pyramid" aria-label={t('符號層級金字塔：Competence 逐層拆解至基本圖形', 'Symbol hierarchy pyramid: Competence decomposed layer by layer into its basic forms')}>
        {pyramid.map((row, ri) => (
          <div class="pyr-row">
            {row.map((c) => (
              <figure class={`pyr-cell${ri === 0 ? ' pyr-apex' : ''}`}>
                <img src={c.img} alt={c.alt} class="symbol-img" />
                <figcaption>{c.label}</figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>

      <p class="declaration-final">{t('這就是勝任力。', 'This is Competence.')}</p>

      <p>{t(
