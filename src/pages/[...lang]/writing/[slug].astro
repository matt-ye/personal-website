---
/*
 * Markdown 文章的動態路由。
 *
 * 遷移前：src/pages/writing/[slug].astro，中英擠在同一個網址，靠內文的
 * .lang-zh/.lang-en 兩個 div 加 CSS 切換顯示。
 * 遷移後：中文在 src/content/blog/<slug>.md、英文在 src/content/blog/en/<slug>.md，
 * 各自是獨立網址、各自 canonical，hreflang 由 BaseLayout 依 lib/i18n.ts 產生。
 *
 * 為什麼要拆：中英同頁時兩個網址的 HTML 幾乎一樣，Google 會判為重複網頁、
 * 整組忽略 hreflang——這正是站上其他頁早就遷移過的理由（見 docs/i18n-architecture-plan.md）。
 */
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { YMYL_SERIES } from '../../../content.config';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  /* 守衛：已知的 YMYL 系列裡，有沒有文章忘記填 `ymyl: true`。
     漏標的後果是財經文章少了免責聲明，而且沒有任何可見症狀——所以在這裡
     擋下來，讓 build 失敗好過安靜上線。新增財經系列時把 series 名稱加進
     content.config.ts 的 YMYL_SERIES。 */
  const missing = posts.filter(
    (p) => p.data.series && YMYL_SERIES.includes(p.data.series) && !p.data.ymyl,
  );
  if (missing.length > 0) {
    throw new Error(
      `這些文章屬於 YMYL 系列但沒填 ymyl: true，免責聲明不會輸出：\n` +
        missing.map((p) => `  - src/content/blog/${p.id}.md（series: ${p.data.series}）`).join('\n'),
    );
  }

  /* collection id 就是相對 src/content/blog 的路徑，所以英文版的 id 帶 `en/` 前綴。
     用它分流比另外維護一份清單可靠——檔案在哪，網址就在哪。

     ⚠ 每篇中文文章都必須有英文對應檔。缺了會少一個 /en/ 網址，而
     lib/i18n.ts 的 MIGRATED_PATHS 仍宣稱有——hreflang 會指向 404。
     下面的守衛擋住這件事。 */
  const zhPosts = posts.filter((p) => !p.id.startsWith('en/'));
  const enSlugs = new Set(posts.filter((p) => p.id.startsWith('en/')).map((p) => p.id.slice(3)));

  const missingEn = zhPosts.filter((p) => !enSlugs.has(p.id));
  if (missingEn.length > 0) {
    throw new Error(
      `這些文章沒有英文對應檔，hreflang 會指向不存在的網址：\n` +
        missingEn.map((p) => `  - 缺 src/content/blog/en/${p.id}.md`).join('\n'),
    );
  }

  return posts.map((post) => ({
    params: post.id.startsWith('en/')
      ? { lang: 'en', slug: post.id.slice(3) }
      : { lang: undefined, slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  lang={post.data.lang}
  tags={post.data.tags}
  ymyl={post.data.ymyl}
>
  <Content />
</PostLayout>
