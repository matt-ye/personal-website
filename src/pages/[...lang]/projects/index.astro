---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import T from '../../../components/T.astro';
import { getCollection } from 'astro:content';
import { projects } from '../../../data/projects';
import { agentSkills } from '../../../data/agentSkills';
import { localeHref } from '../../../lib/i18n';

/* 同時產出 /projects/ 與 /en/projects/，見 [...lang]/about.astro 的說明。 */
export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const isEn = Astro.currentLocale === 'en';

async function seriesPosts(series: string) {
  const posts = (await getCollection('blog', ({ data }) => !data.draft && data.series === series))
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
    .slice(0, 3);

  return posts.map((post) => ({
    href: `/writing/${post.id}/`,
    /* 11 篇文章只有 1 篇填了 titleEn。英文頁沒有英文標題時退回中文，
       並標 lang="zh-TW"——空白比中文更糟（讀者什麼都看不到），
       但讓爬蟲把中文當成英文更糟（會污染這一頁的語言判定）。
       翻譯是唯一無法自動化的部分，見 docs/i18n-architecture-plan.md 第 3 節。 */
    title: isEn ? (post.data.titleEn ?? post.data.title) : post.data.title,
    titleLang: isEn && !post.data.titleEn ? 'zh-TW' : undefined,
    date: post.data.pubDate.toLocaleDateString(isEn ? 'en-US' : 'zh-TW', {
      month: 'numeric',
      day: 'numeric',
    }),
  }));
}

const investingPosts = await seriesPosts('family-investing');
const managementPosts = await seriesPosts('management-3r');
const presentationPosts = await seriesPosts('hardcore-presentation');
---
<BaseLayout
  title={isEn ? 'Projects' : 'Projects — Matt Ye'}
  description={isEn
    ? "Side projects by Ching-Wei (Matt) Ye — interactive tools, open-source AI agent skills, experiments, and One More Step learning notes."
    : '葉淨維 Matt Ye 的 Side Projects — 互動工具、開源 AI agent skills、實驗性作品，以及 One More Step 學習筆記。'}
  lang={isEn ? 'en' : 'zh-TW'}
>
  <section class="projects-hero">
    <h1><T zh="個人" en="Side" /> <span class="accent-text"><T zh="專案" en="Projects" /></span></h1>
    <p class="projects-subtitle"><T zh="正在做的東西。實驗性質，持續演進。" en="Things I'm currently building — experimental, and always evolving." /></p>
  </section>

  <div class="projects-grid">
    {projects.map(p => (
      <div
        class={`project-card ${p.status === 'in-progress' ? 'card-wip' : ''}`}
        {...(p.url ? { 'data-href': p.url, ...(p.internal ? {} : { 'data-external': 'true' }) } : {})}
      >
        <div class="project-card-header">
          <div>
            <h2 class="project-title"><T zh={p.title} en={p.titleEn} /></h2>
            {/* 這行副標在中文頁是「英文對照」，在英文頁會和上面的 h2 一字不差地
                重複，所以英文路由不輸出。
                下面四張卡的 project-title-en 是各自獨立的副標（例如「Presentation ·
                The PEOP Field Guide」），不是對照，兩種語言都保留。 */}
            {!isEn && <p class="project-title-en">{p.titleEn}</p>}
          </div>
          <span class={`project-badge badge-${p.status}`}>
            {p.status === 'live'
              ? <T zh="上線中" en="Live" />
              : p.status === 'in-progress'
                ? <T zh="進行中" en="In Progress" />
                : <T zh="已封存" en="Archived" />}
          </span>
        </div>
        <p class="project-desc"><T zh={p.description} en={p.descriptionEn} /></p>
        <div class="project-footer">
          <div class="project-tags">
            {p.tags.map((tag, i) => <span class="project-tag"><T zh={tag} en={p.tagsEn[i]} /></span>)}
          </div>
          {p.url
            ? <a href={p.url} {...(p.internal ? {} : { target: '_blank', rel: 'noopener noreferrer' })} class="project-link"><T zh="前往 →" en="Visit →" /></a>
            : <span class="project-link-disabled"><T zh="即將上線" en="Coming Soon" /></span>
          }
        </div>
      </div>
    ))}

    <!-- AI Agent Skills：仿寫作系列卡的「標題清單」寫法，卡片不放描述。
         完整說明在 /projects/agent-skills/，清單資料在 src/data/agentSkills.ts。
         id 供外部深連結 /projects/#agent-skills -->
    <div class="project-card" id="agent-skills" data-href={localeHref('/projects/agent-skills/', Astro.currentLocale)}>
      <div class="project-card-header">
        <div>
          <h2 class="project-title"><T zh="AI Agent Skills" en="AI Agent Skills" /></h2>
          <p class="project-title-en">Open-source skills for AI agents</p>
        </div>
        <span class="project-badge badge-skill"><T zh="開源" en="Open Source" /></span>
      </div>

      <ul class="series-mini-list">
        {agentSkills.map(s => (
          <li class="series-mini-item">
            <a href={`/projects/agent-skills/#${s.slug}`} class="series-mini-title"><T zh={s.title} en={s.titleEn} /></a>
          </li>
        ))}
      </ul>

      <div class="project-footer">
        <div class="project-tags">
          <span class="project-tag"><T zh="AI Agent" en="AI Agent" /></span>
          <span class="project-tag"><T zh="開源工具" en="Open-Source Tools" /></span>
        </div>
        <a href={localeHref('/projects/agent-skills/', Astro.currentLocale)} class="project-link"><T zh="完整說明 →" en="Details →" /></a>
      </div>
    </div>

    <!-- Hardcore Presentation Series Card -->
    <div class="project-card" data-href="/writing/?series=硬核簡報">
      <div class="project-card-header">
        <div>
          <h2 class="project-title"><T zh="人、環境、職能：硬核簡報的科學" en="Hardcore Presentation" /></h2>
          <p class="project-title-en">Presentation · The PEOP Field Guide</p>
        </div>
        <span class="project-badge badge-series"><T zh="連載中" en="Ongoing Series" /></span>
      </div>

      {presentationPosts.length > 0 ? (
        <ul class="series-mini-list">
          {presentationPosts.map(post => (
            <li class="series-mini-item">
              {/* 沒有英文標題時退回中文並標 lang——見上方 seriesPosts() 的說明 */}
              <a href={post.href} class="series-mini-title" lang={post.titleLang}>{post.title}</a>
              <span class="series-mini-date">{post.date}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="project-desc"><T zh="從認知科學、語言學到表演藝術，拆解「簡報表達」這項職能。硬核知識，逐步上線。" en="Deconstructing presentation as an occupation — from cognitive science and linguistics to the performing arts. Hardcore knowledge, rolling out." /></p>
      )}

      <div class="project-footer">
        <div class="project-tags">
          <span class="project-tag"><T zh="認知科學" en="Cognitive Science" /></span>
          <span class="project-tag"><T zh="表達" en="Communication" /></span>
        </div>
        <a href="/writing/?series=硬核簡報" class="project-link"><T zh="查看全部 →" en="View all →" /></a>
      </div>
    </div>

    <!-- Investing Series Card -->
    <div class="project-card" data-href="/writing/?series=投資專欄">
      <div class="project-card-header">
        <div>
          <h2 class="project-title"><T zh="寫給家人：投資心態" en="Letters to Family: An Investing Mindset" /></h2>
          <p class="project-title-en">Family · Investing Mindset</p>
        </div>
        <span class="project-badge badge-series"><T zh="連載中" en="Ongoing Series" /></span>
      </div>

      {investingPosts.length > 0 ? (
        <ul class="series-mini-list">
          {investingPosts.map(post => (
            <li class="series-mini-item">
              {/* 沒有英文標題時退回中文並標 lang——見上方 seriesPosts() 的說明 */}
              <a href={post.href} class="series-mini-title" lang={post.titleLang}>{post.title}</a>
              <span class="series-mini-date">{post.date}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="project-desc"><T zh="從基礎金融知識到價值投資心法，寫給我的家人。文章即將上線。" en="From financial fundamentals to value-investing principles — written for my family. Posts coming soon." /></p>
      )}

      <div class="project-footer">
        <div class="project-tags">
          <span class="project-tag"><T zh="價值投資" en="Value Investing" /></span>
          <span class="project-tag"><T zh="總體經濟" en="Macroeconomics" /></span>
        </div>
        <!-- ?series= 的值必須與 /writing 卡片的 data-category 完全相同（中文），
             篩選是直接字串比對；llms.txt 也是用中文值當正式網址。 -->
        <a href="/writing/?series=投資專欄" class="project-link"><T zh="查看全部 →" en="View all →" /></a>
      </div>
    </div>

    <!-- Management 3R Series Card -->
    <div class="project-card" data-href="/writing/?series=管理專欄">
      <div class="project-card-header">
        <div>
          <h2 class="project-title"><T zh="天時、地利、人和：現代管理者的 3R 實踐指南" en="Right Time, Right Place, Right People" /></h2>
          <p class="project-title-en">Management · The 3R Practice Guide</p>
        </div>
        <span class="project-badge badge-series"><T zh="連載中" en="Ongoing Series" /></span>
      </div>

      {managementPosts.length > 0 ? (
        <ul class="series-mini-list">
          {managementPosts.map(post => (
            <li class="series-mini-item">
              {/* 沒有英文標題時退回中文並標 lang——見上方 seriesPosts() 的說明 */}
              <a href={post.href} class="series-mini-title" lang={post.titleLang}>{post.title}</a>
              <span class="series-mini-date">{post.date}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="project-desc"><T zh="用「天時、地利、人和」對接策略、營運、組織三大管理面向。自學與紀錄管理知能的空間，文章即將上線。" en="Mapping strategy, operations, and organization onto Right Time, Right Place, Right People — a space to learn and document management. Posts coming soon." /></p>
      )}

      <div class="project-footer">
        <div class="project-tags">
          <span class="project-tag"><T zh="策略" en="Strategy" /></span>
          <span class="project-tag"><T zh="組織" en="Organization" /></span>
        </div>
        <a href="/writing/?series=管理專欄" class="project-link"><T zh="查看全部 →" en="View all →" /></a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .projects-hero {
    padding: 3rem 0 2rem;
  }

  .projects-hero h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .projects-subtitle {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .project-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: box-shadow 0.2s;
  }

  .project-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .card-wip {
    border-style: dashed;
  }

  .project-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .project-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0;
  }

  .project-title-en {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0.15rem 0 0;
  }

  .project-badge {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.55rem;
    border-radius: 99px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .badge-live {
    background: #d1fae5;
    color: #065f46;
  }

  .badge-in-progress {
    background: #fef3c7;
    color: #92400e;
  }

  .badge-archived {
    background: var(--color-border);
    color: var(--color-text-muted);
  }

  .badge-skill {
    background: #ede9fe;
    color: #5b21b6;
  }

  /* 整卡可點：有 data-href 的卡片游標提示；實際導頁在 <script> 委派處理 */
  .project-card[data-href] { cursor: pointer; }

  .badge-series {
    background: #dbeafe;
    color: #1e40af;
  }

  .project-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
    flex: 1;
  }

  .project-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .project-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .project-tag {
    font-size: 0.72rem;
    background: var(--color-border);
    color: var(--color-text-muted);
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
  }

  .project-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  .project-link-disabled {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .series-mini-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    flex: 1;
  }

  .series-mini-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
  }

  .series-mini-title {
    font-size: 0.88rem;
    color: var(--color-text);
    text-decoration: none;
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .series-mini-title:hover {
    color: var(--color-accent);
  }

  .series-mini-date {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }
</style>

<script>
  /* 整卡可點。用事件委派：點到卡內既有的 <a>（文章、skill、前往）時讓連結
     自己處理，不攔截；點到卡片其他區域才走 data-href。外部連結開新分頁，
     與卡內「前往 →」的 target=_blank 行為一致。
     文字選取不算點擊——按下與放開位置有位移就跳過，避免選字誤觸導頁。 */
  let downAt: [number, number] | null = null;
  document.addEventListener('pointerdown', e => { downAt = [e.clientX, e.clientY]; });

  document.addEventListener('click', e => {
    const target = e.target as HTMLElement;
    if (target.closest('a')) return;
    const card = target.closest<HTMLElement>('.project-card[data-href]');
    if (!card) return;
    if (downAt && Math.hypot(e.clientX - downAt[0], e.clientY - downAt[1]) > 6) return;
    const url = card.dataset.href!;
    if (card.dataset.external === 'true') window.open(url, '_blank', 'noopener');
    else window.location.assign(url);
  });
</script>
