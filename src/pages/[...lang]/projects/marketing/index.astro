---
/*
 * 行銷專欄的樞紐頁。同時產出 /projects/marketing/ 與 /en/projects/marketing/。
 *
 * ── 為什麼現在才遷 ────────────────────────────────────────────────
 * 遷移順序刻意由下往上：先讓 4 個子頁有英文版（PR #222），這頁才值得遷。
 * 反過來做的話英文樞紐頁會是空列表，而薄內容 Google 不收——
 * 這頁的中文版就被判過「已檢索但未收錄」。
 *
 * ── 英文頁列幾個單元 ──────────────────────────────────────────────
 * 只列有英文版的。Matt 已定：未遷移的項目在英文頁**隱藏**，不退回中文。
 * 目前 marketing-foundations 沒有英文版（13 處純中文未補譯），所以英文頁 4 個、
 * 中文頁 5 個。判準直接問 hasEnglishRoute()，不另外維護清單——
 * 那份清單一定會和 MIGRATED_PATHS 走岔，而且走岔時沒有人會發現。
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import T from '../../../../components/T.astro';
import { marketingUnits } from '../../../../data/marketing';
import { staticPageMeta } from '../../../../data/staticPageMeta';
import { localeHref, hasEnglishRoute } from '../../../../lib/i18n';

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: 'en' } }];
}

const isEn = Astro.currentLocale === 'en';
const locale = isEn ? 'en' : 'zh';

const unitPath = (d: { slug: string; url?: string }) => d.url ?? `/projects/marketing/${d.slug}/`;
const docs = isEn ? marketingUnits.filter((d) => hasEnglishRoute(unitPath(d))) : marketingUnits;

/* 卡片描述的英文版取自 staticPageMeta——那批文案是隨 PR #222 一起核准的，
   在這裡重寫一次等於製造第二份會走岔的真相。marketing.ts 的 description
   只有中文，短期內不打算補：資料的英文欄位散在兩個檔是既有狀態，
   統一它是另一件事，不該夾在這次遷移裡。 */
const metaBySlug = Object.fromEntries(
  staticPageMeta
    .filter((m) => m.key.startsWith('projects__marketing__'))
    .map((m) => [m.key.replace('projects__marketing__', ''), m]),
);
const descOf = (d: { slug: string; description: string }) =>
  (isEn && metaBySlug[d.slug]?.descriptionEn) || d.description;

/* 標籤原本全是中文字串，英文頁直接印會變成一排中文小標。
   已經是英文的（Launch／Repurposing／Faceless…）不在表裡，會原樣通過。 */
const TAG_EN: Record<string, string> = {
  行銷: 'Marketing', 框架: 'Frameworks', 社群經營: 'Social Media', 演算法: 'Algorithms',
  短影音: 'Short-Form Video', 開發者行銷: 'Developer Marketing', 腳本: 'Scripting',
  'AI 工具': 'AI Tools', 合規: 'Compliance',
};
const tagLabel = (t: string) => (isEn ? TAG_EN[t] ?? t : t);
---
{/* lang 一定要傳：BaseLayout 靠它決定站名後綴與 JSON-LD 的 inLanguage。 */}
<BaseLayout
  lang={isEn ? 'en' : 'zh-TW'}
  title={isEn ? 'Marketing Column' : '行銷專欄 Marketing Column'}
  description={isEn
    /* ⚠ 上限 160 字元（L1-DESC-LONG）。第一版 162 字元，被檢核器擋下來——
       英文比中文更容易超過，因為同樣的資訊量需要更多字元。 */
    ? 'Matt Ye’s marketing column: public notes from a 52-week roadmap — platform algorithms, short-form video, developer marketing and brand strategy.'
    : '葉淨維 Matt Ye 的行銷專欄：52 週行銷學習地圖的公開筆記，涵蓋平台演算法、短影音、開發者行銷到品牌策略。'}
>
  <section class="mkt-hero">
    <a href={localeHref('/projects/', locale)} class="back-link"><T zh="← 其他作品" en="← Side Projects" /></a>
    <h1><T zh="行銷" en="Marketing" /> <span class="accent-text"><T zh="專欄" en="Column" /></span></h1>
    <p class="mkt-subtitle"><T zh="一年 52 週的行銷學習地圖，每週一個可實作的單元。" en="A 52-week marketing learning roadmap — one actionable unit at a time." /></p>
  </section>

  <div class="docs-grid">
    {docs.map(doc => (
      <a href={localeHref(unitPath(doc), locale)} class="doc-card">
        <div class="doc-card-body">
          <h2 class="doc-title"><T zh={doc.title} en={doc.titleEn} /></h2>
          <p class="doc-desc">{descOf(doc)}</p>
        </div>
        <div class="doc-footer">
          <div class="doc-tags">
            {doc.tags.map(tag => <span class="doc-tag">{tagLabel(tag)}</span>)}
          </div>
          <span class="doc-link"><T zh="閱讀 →" en="Read →" /></span>
        </div>
      </a>
    ))}
  </div>
</BaseLayout>

<style>
  .mkt-hero {
    padding: 3rem 0 2rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: 1rem;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .mkt-hero h1 {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .mkt-subtitle {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin: 0;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding-bottom: 4rem;
  }

  .doc-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .doc-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    border-color: var(--color-accent);
  }

  .doc-card-body {
    flex: 1;
  }

  .doc-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.15rem;
  }

  .doc-desc {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .doc-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .doc-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .doc-tag {
    font-size: 0.72rem;
    background: var(--color-border);
    color: var(--color-text-muted);
    padding: 0.15rem 0.5rem;
    border-radius: 99px;
  }

  .doc-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent);
    white-space: nowrap;
  }
</style>
