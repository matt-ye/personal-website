---
/*
 * 26 個課程週次頁的動態路由。
 *
 * 遷移前：public/projects/family-investing-course/week-NN/index.html
 *         26 個手刻檔，每個自帶完整的 head 與 11.5 KB 的 <style>。
 * 遷移後：meta 在 src/data/courseWeekMeta.ts、內容在 src/data/course-weeks/，
 *         head 由 CourseWeekLayout 統一產生。
 *
 * 內容用 set:html 原樣輸出，一個字都不改——那些 <script> 是各週的互動
 * 計算機（複利、雪球、效率前緣、DCF 組裝台…），每支都不一樣。
 * 靜態產生時 set:html 是把字串寫進輸出的 HTML，不是瀏覽器端的 innerHTML，
 * 所以裡面的 <script> 會照常執行。
 *
 * ── 為什麼從 pages/projects/ 搬到 pages/[...lang]/projects/ ──────────
 * 原本這個檔案不在 [...lang] 底下，所以整批只產得出中文網址。
 * 這 26 頁與 one-more-step 那批結構相同——純中文、沒有語言鈕、沒有
 * zh-only、沒有 data-i18n——所以英文版走同一套機制 C：由
 * src/data/translations/<slug>.mjs 的整頁對照表在建置期換出來。
 *
 * 英文版只產「有填英文 meta 且有對照表」的週次。兩個條件都從資料推導，
 * 不維護清單：翻好一週就多一個網址，沒翻的單純沒有 /en/ 版。
 */
import CourseWeekLayout from '../../../../layouts/CourseWeekLayout.astro';
import { courseWeekMeta } from '../../../../data/courseWeekMeta';
import { translateFragment } from '../../../../lib/translateFragment.mjs';
import { injectLangButton } from '../../../../lib/langButton.mjs';

/* eager: true 讓內容在建置時就併進來——這些是靜態教材，
   沒有動態載入的必要，也避免 26 個額外的 chunk。 */
const fragments = import.meta.glob('../../../../data/course-weeks/*.html', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;

const tables = import.meta.glob('../../../../data/translations/*.mjs', { eager: true }) as Record<
  string,
  { MAP?: Record<string, string>; KEEP?: string[] }
>;

/* ⚠ getStaticPaths 會被 Astro 抽出來獨立執行，看不到 frontmatter 的模組作用域，
     所以 glob 在這裡重跑一次。同 one-more-step/[slug].astro 的處理。 */
export function getStaticPaths() {
  const t = import.meta.glob('../../../../data/translations/*.mjs', { eager: true });
  return courseWeekMeta.flatMap((meta) => {
    const paths = [{ params: { lang: undefined, slug: meta.slug }, props: { meta } }];
    const hasTable = Object.keys(t).some((p) => p.endsWith(`/${meta.slug}.mjs`));
    if (meta.titleEn && meta.descriptionEn && hasTable) {
      paths.push({ params: { lang: 'en', slug: meta.slug }, props: { meta } });
    }
    return paths;
  });
}

const { meta } = Astro.props;
const isEn = Astro.currentLocale === 'en';

const key = Object.keys(fragments).find((p) => p.endsWith(`/${meta.slug}.html`));
/* 找不到片段就讓建置失敗——安靜輸出一個空白教材頁，比壞掉更難發現 */
if (!key) throw new Error(`找不到課程內容片段：src/data/course-weeks/${meta.slug}.html`);
let body = fragments[key];

const tablePath = Object.keys(tables).find((p) => p.endsWith(`/${meta.slug}.mjs`));
if (isEn && tablePath) {
  /* 三道守衛（漏譯／殘留中文／script 還能不能解析）都在這支裡，
     與 one-more-step 那批共用——複製一份就是下一次走鐘的起點。 */
  body = translateFragment(body, tables[tablePath], meta.slug);
}

/* 語言鈕插進頁面自己的頂欄（#themeToggle 旁邊）。這批頁很長，
   放頁尾等於沒有——紀念頁踩過這個坑。 */
const zhPath = `/projects/family-investing-course/${meta.slug}/`;
if (meta.titleEn && meta.descriptionEn && tablePath) {
  body = injectLangButton(body, {
    href: isEn ? zhPath : `/en${zhPath}`,
    hreflang: isEn ? 'zh-TW' : 'en',
    isEn,
  });
}
---

<CourseWeekLayout meta={meta}>
  <Fragment set:html={body} />
</CourseWeekLayout>
