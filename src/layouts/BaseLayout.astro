---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AnalyticsEvents from '../components/AnalyticsEvents.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

const {
  title,
  description = '葉淨維 Ching-Wei (Matt) Ye 的個人網站',
  lang = 'zh-TW',
  ogType = 'website',
  /* 預設分享圖用捕夢網 LOGO，不用本人照片——只有首頁需要把臉放在分享卡上，
     子頁面全部是自己的臉會很奇怪。首頁自行傳 image="/OG.png" 覆寫。 */
  image = '/og-logo.png',
} = Astro.props;

const siteURL = Astro.site ?? 'https://mattye.dev';
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(image, siteURL);
const siteName = '葉淨維 Matt Ye';
/* 首頁傳 title === siteName 時不加後綴（避免「葉淨維 Matt Ye · 葉淨維 Matt Ye」），
   但光是人名對搜尋結果的資訊量太低——補一句身分描述。
   長度控制：中文標題約 40 字元內不會被 SERP 截斷，這裡是 28 字元。 */
const fullTitle =
  title === siteName
    ? `${siteName}｜職能治療師 · 簡報教練 · AI 認知科學研究`
    : `${title} · ${siteName}`;

const personLd = {
  '@type': 'Person',
  '@id': 'https://mattye.dev/#person',
  name: 'Ching-Wei (Matt) Ye',
  alternateName: '葉淨維',
  url: 'https://mattye.dev',
  jobTitle: 'PhD Candidate · Presentation Coach',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'National Taiwan University' },
  /* sameAs 是把散在各平台的身分串成同一個實體，搜尋引擎與 AI 引擎靠它確認
     「這些帳號是同一個人」。清單越完整，實體識別越穩——但每一條都必須是
     本人實際擁有且公開的帳號，填錯會把別人的身分綁到你頭上。 */
  sameAs: [
    'https://www.linkedin.com/in/ching-wei-ye',
    'https://x.com/MattChingWeiYe',
    'https://orcid.org/0009-0001-6085-8303',
    'https://www.instagram.com/brown.yeh',
  ],
};
const websiteLd = {
  '@type': 'WebSite',
  '@id': 'https://mattye.dev/#website',
  name: siteName,
  url: 'https://mattye.dev',
  inLanguage: 'zh-TW',
  datePublished: '2026-05-31',
  copyrightYear: 2026,
  publisher: { '@id': 'https://mattye.dev/#person' },
};
const jsonLd = { '@context': 'https://schema.org', '@graph': [personLd, websiteLd] };
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Prevent flash of wrong theme (runs before render) -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = saved ?? (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <!-- Language preference (runs before render; default zh) -->
    <script is:inline>
      (function () {
        const lang = localStorage.getItem('lang') === 'en' ? 'en' : 'zh';
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang === 'en' ? 'en' : 'zh-TW';
      })();
    </script>

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonicalURL} />

    {/* RSS 閱讀器與瀏覽器靠這行自動發現 feed：使用者只要貼 mattye.dev
        就能訂閱，不必知道 /rss.xml 這個路徑。 */}
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <meta name="author" content="Ching-Wei (Matt) Ye" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    {/* creator 標作者、site 標網站帳號——X 的卡片歸屬兩者都會讀，只有 creator 會少一半。
      個人網站兩者同帳號是正常的。
      ⚠ 這個值必須是真實存在的 handle：先前填的 @mattye_dev 查證為 404（不存在），
      推測是從網域名 mattye.dev 推想出來的。錯的 handle 會讓卡片歸屬失效。 */}
  <meta name="twitter:site" content="@MattChingWeiYe" />
  <meta name="twitter:creator" content="@MattChingWeiYe" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1RKL72DPPW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-1RKL72DPPW');
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot name="full-width" />
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
    <AnalyticsEvents />
  </body>
</html>
