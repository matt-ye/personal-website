---
import BaseLayout from './BaseLayout.astro';
import { tagLabel } from '../lib/tagLabels';
import { localeHref } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  lang?: 'zh' | 'en';
  tags?: string[];
  ymyl?: boolean;
}

const { title, description, pubDate, updatedDate, lang = 'zh', tags, ymyl = false } = Astro.props;

/* 文章拆成獨立網址之後，這一頁只有一種語言——標題、日期、標籤都直接依 lang
   輸出，不再用 <T> 或 .lang-zh/.lang-en 兩份都印再交給 CSS 切。
   在單語頁輸出兩份的代價不只是多餘的位元組：英文頁的 HTML 裡混著中文，
   對爬蟲就是語言判定的雜訊。 */
const isEn = lang === 'en';
const t = (zh: string, en: string) => (isEn ? en : zh);

const htmlLang = isEn ? 'en' : 'zh-TW';

const dateFormatted = pubDate.toLocaleDateString(isEn ? 'en-US' : 'zh-TW', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/OG.png', Astro.site).href;

const articleLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": pubDate.toISOString(),
  /* 只有實際填了 updatedDate 才輸出。沒填就不給，而不是拿 pubDate 或建置時間充數——
     不準的時間訊號會讓 Google 連帶不信任整站的日期（同 sitemap lastmod 的處理）。 */
  ...(updatedDate ? { "dateModified": updatedDate.toISOString() } : {}),
  "inLanguage": htmlLang,
  "author": {
    "@type": "Person",
    "@id": "https://mattye.dev/#person",
    "name": "Ching-Wei (Matt) Ye"
  },
  "publisher": { "@id": "https://mattye.dev/#person" },
  "mainEntityOfPage": canonicalURL,
  "image": ogImage
};
---
<BaseLayout title={title} description={description} lang={htmlLang} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleLd)} />

  <a href={localeHref('/writing/', lang)} class="back-link">← Writing</a>

  <header class="post-page-header">
    <h1>{title}</h1>
    <div class="post-meta">
      {/* 作者署名。在此之前「葉淨維」只出現在 <title>、meta 與頁尾版權——
          那些位置對讀者與評分員都不算內容創作者資訊。rel="author" 是這層
          關係的機器可讀宣告，連到 /about/ 讓資歷可查證。 */}
      <a class="post-author" href={localeHref('/about/', lang)} rel="author">
        {t('葉淨維', 'Matt Ye')}
      </a>
      <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
      {updatedDate && (
        <time class="post-updated" datetime={updatedDate.toISOString()}>
          {isEn
            ? `Updated ${updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}`
            : `更新於 ${updatedDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}`}
        </time>
      )}
      <span class="lang-badge">{t('中', 'EN')}</span>
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => <span class="tag">{isEn ? tagLabel(tag, true) : tag}</span>)}
        </div>
      )}
    </div>
  </header>

  <article class="prose">
    <slot />
  </article>

  {/* YMYL 免責聲明。措辭沿用課程頁既有的那句（本課程→本文），定性為
      「個人學習紀錄」而非專家建議——這對應 Rater Guidelines 3.4.1 節
      Experience 與 Expertise 的分野。

      放在 </article> 之外是刻意的：它不是文章內容，是關於這篇文章的聲明。
      放進 prose 裡會被 RSS 全文與 LLM 當成正文的一部分。 */}
  {ymyl && (
    <aside class="post-disclaimer" role="note">
      {t(
        '本文為個人學習紀錄與家人教育素材，非投資建議；內容涉及之制度與稅率以主管機關現行公告為準。',
        'This article is a personal learning record and educational material for my family — not investment advice. Any regulations or tax rates mentioned are subject to the current announcements of the competent authorities.',
      )}
    </aside>
  )}

  <!-- Tab switching for diagram posts -->
  <script is:inline>
  (function() {
    function initTabs() {
      document.querySelectorAll('.dtabs').forEach(function(tabs) {
        tabs.querySelectorAll('.dtab-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var panelId = btn.dataset.panel;
            tabs.querySelectorAll('.dtab-btn').forEach(function(b) { b.classList.remove('dtab-active'); });
            tabs.querySelectorAll('.dtab-panel').forEach(function(p) { p.classList.remove('dtab-active'); });
            btn.classList.add('dtab-active');
            document.getElementById(panelId).classList.add('dtab-active');
          });
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTabs);
    } else {
      initTabs();
    }
  })();
  </script>
</BaseLayout>
