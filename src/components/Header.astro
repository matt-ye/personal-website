---
import T from './T.astro';
const pathname = Astro.url.pathname;
---
<header>
  <div class="container">
    <a href="/" class="site-name">Matt Ye</a>
    <div class="nav-right">
      <nav>
        <a href="/" aria-current={pathname === '/' ? 'page' : undefined}><T zh="首頁" en="Home" /></a>
        <a href="/speeches/" aria-current={pathname.startsWith('/speeches') ? 'page' : undefined}><T zh="演講" en="Speeches" /></a>
        <a href="/coaching/" aria-current={pathname.startsWith('/coaching') ? 'page' : undefined}><T zh="培訓" en="Coaching" /></a>
        <a href="/writing/" aria-current={pathname.startsWith('/writing') ? 'page' : undefined}><T zh="寫作" en="Writing" /></a>
        <a href="/projects/" aria-current={pathname.startsWith('/projects') ? 'page' : undefined}><T zh="專案" en="Projects" /></a>
      </nav>
      <button class="lang-toggle" id="lang-toggle" aria-label="切換語言 / Switch language">
        <span class="lang-zh">EN</span><span class="lang-en">中</span>
      </button>
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle dark/light mode">
        <!-- Sun icon (shown in dark mode) -->
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/>
          <line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') ?? 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  /* <T> 產出的 en 區塊在 HTML 裡預設帶 hidden（給不套 CSS 的爬蟲讀）。
     切換語言時必須把 hidden 對調，否則會出現「畫面看得到、但螢幕閱讀器
     被 hidden 跳過」的不一致狀態。顯示與否仍由 CSS 負責，這裡只管語義。 */
  function syncLangHidden(lang: string) {
    const en = lang === 'en';
    document.querySelectorAll('.lang-zh').forEach(el => el.toggleAttribute('hidden', en));
    document.querySelectorAll('.lang-en').forEach(el => el.toggleAttribute('hidden', !en));
  }
  syncLangHidden(document.documentElement.getAttribute('data-lang') ?? 'zh');

  const langBtn = document.getElementById('lang-toggle');
  langBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-lang') ?? 'zh';
    const next = current === 'en' ? 'zh' : 'en';

    /* 已遷移成獨立網址的頁面（有 hreflang 標籤）改為換網址，而不是切 CSS。
       用 hreflang 當訊號是刻意的：那組標籤本來就只在有英文網址時才輸出，
       不必再多傳一個旗標——多一個訊號就多一個會不同步的地方。

       偏好先存再跳轉，讓下一頁（若尚未遷移）沿用同樣的語言。 */
    const alt = document.querySelector(
      `link[rel="alternate"][hreflang="${next === 'en' ? 'en' : 'zh-TW'}"]`,
    ) as HTMLLinkElement | null;
    if (alt) {
      localStorage.setItem('lang', next);
      window.location.href = alt.href;
      return;
    }

    document.documentElement.setAttribute('data-lang', next);
    document.documentElement.lang = next === 'en' ? 'en' : 'zh-TW';
    localStorage.setItem('lang', next);
    syncLangHidden(next);
    window.dispatchEvent(new Event('langchange'));
  });
</script>
