---
/*
 * 渲染 src/data/static-pages/<key>.html 的內容片段。
 *
 * 用 set:html 原樣輸出，一個字都不改——那些片段裡有各頁自己的互動邏輯
 * （GA4 教學的搜尋與術語面板、lemon-squeezy 的步驟導覽、紀念頁的留言板…），
 * 每一支都不一樣。
 *
 * 靜態產生時 set:html 是把字串寫進輸出的 HTML，不是瀏覽器端的 innerHTML，
 * 所以裡面的 <script> 會照常執行。
 */
interface Props {
  pageKey: string;
  /**
   * 這頁有獨立的英文網址時傳入兩版的路徑。傳了才會做語言相關的改寫；
   * 尚未遷移的靜態頁不傳，行為一個字都不變。
   */
  localized?: { zhPath: string; enPath: string };
}

import { localeHref } from '../lib/i18n';

const { pageKey, localized } = Astro.props;
const isEn = Astro.currentLocale === 'en';

/* eager: true 讓內容在建置時併進來——這些是靜態頁，沒有動態載入的必要 */
const fragments = import.meta.glob('../data/static-pages/*.html', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>;

const path = Object.keys(fragments).find((p) => p.endsWith(`/${pageKey}.html`));
/* 找不到就讓建置失敗——安靜輸出一個空白頁比壞掉更難發現 */
if (!path) throw new Error(`找不到內容片段：src/data/static-pages/${pageKey}.html`);

/*
 * 英文路由在建置期剝掉中文半邊。
 *
 * 這些頁的雙語是成對的 <span class="zh-only"> / <span class="en-only">，靠 CSS
 * 決定顯示哪一邊。CSS 只在瀏覽器套樣式後才成立，而許多爬蟲（含 LLM）直接讀
 * 原始 HTML——所以 /en/ 若原樣輸出，爬蟲會讀到「時間軸結構The Timeline」這種
 * 兩種語言黏在一起的字串，正是 L2-BILINGUAL-CONCAT 報的那件事。
 *
 * 既然 [...lang] 在建置期就知道語言，就不該再把判斷丟給 CSS。
 * 中文路由維持雙 DOM 不變（切換鈕仍需要），與 T.astro 的處理一致。
 */
const LANG_EL = (cls: string) =>
  new RegExp(`<(\\w+)([^>]*\\bclass="[^"]*\\b${cls}\\b[^"]*")[^>]*>[\\s\\S]*?<\\/\\1>`, 'gi');

/* ⚠ 上面的非貪婪 + </\1> 反向參照，只有在「語言 span 內沒有同名巢狀標籤」時才正確
   （<span class="zh-only">…<strong>x</strong>…</span> 沒問題，套一層 <span> 就會提早閉合）。
   今天全部檔案實測是 0 個同名巢狀，但那是資料的性質、不是程式的保證——
   內容之後被編輯就可能不成立，所以在這裡斷言，不只寫在註解裡。 */
function assertNoSameTagNesting(html: string, cls: string) {
  const re = new RegExp(`<(\\w+)([^>]*\\bclass="[^"]*\\b${cls}\\b[^"]*")[^>]*>([\\s\\S]*?)<\\/\\1>`, 'gi');
  for (const m of html.matchAll(re)) {
    if (new RegExp(`<${m[1]}[\\s>]`, 'i').test(m[3])) {
      throw new Error(
        `${pageKey}：<${m[1]} class="${cls}"> 內含同名的 <${m[1]}>，語言剝除會提早閉合。` +
          `請改用不同標籤包內層，或改寫剝除邏輯。片段：${m[3].slice(0, 80)}`,
      );
    }
  }
}

/*
 * 屬性裡的中文，剝 zh-only 剝不掉。
 *
 * 上面那套剝除處理的是「成對的語言 span」，但 placeholder、aria-label、alt、
 * title 是**純文字語境**，塞不進 span——所以這些頁的雙語是直接寫成
 * placeholder="搜尋… / Search…"。中文頁看起來合理，英文頁就是殘留的中文。
 *
 * 規則：值裡有中文時，取最後一個 " / " 之後的部分。
 * 沒有分隔符就讓建置失敗——這種情況推導不出英文，安靜放行等於把中文送上英文頁。
 * 目前 5 頁 marketing 全部都有分隔符，所以這個 throw 現在不會觸發；
 * 等 one-more-step 那批遷移時，它們的純中文屬性會直接讓 build 停下來。
 *
 * ⚠ 只改 script／style 以外的部分。片段裡的 <script> 有自己的字串，
 *   長得跟 HTML 屬性一模一樣，改到就是改壞用戶端程式碼。
 */
const ATTR = /\s(placeholder|aria-label|alt|title)="([^"]*)"/g;
const CJK = /[一-鿿]/;

function stripCjkAttrs(html: string) {
  /* 用 script/style 當分界切片，只在片段之間改寫 */
  const guarded = /<(script|style)\b[^>]*>[\s\S]*?<\/\1>/gi;
  let out = '';
  let last = 0;
  for (const m of html.matchAll(guarded)) {
    out += rewrite(html.slice(last, m.index)) + m[0];
    last = m.index! + m[0].length;
  }
  return out + rewrite(html.slice(last));

  function rewrite(chunk: string) {
    return chunk.replace(ATTR, (whole, attr: string, val: string) => {
      if (!CJK.test(val)) return whole;
      const i = val.lastIndexOf(' / ');
      if (i < 0) {
        throw new Error(
          `${pageKey}：英文路由的 ${attr}="${val}" 是純中文，沒有 " / " 可以取英文半邊。` +
            `請在片段裡改成「中文 / English」，或直接改用英文。`,
        );
      }
      return ` ${attr}="${val.slice(i + 3)}"`;
    });
  }
}

let fragment = fragments[path];
if (isEn) {
  assertNoSameTagNesting(fragment, 'zh-only');
  fragment = fragment.replace(LANG_EL('zh-only'), '');
  fragment = stripCjkAttrs(fragment);
}

/*
 * 有獨立英文網址的頁：把「頁內 CSS 切換語言」換成「換網址」。
 *
 * 這些頁原本自帶一顆 toggleLang() 按鈕，靠 CSS 的
 *   [data-lang="zh"] .en-only { display:none }
 *   [data-lang="en"] .zh-only { display:none }
 * 決定顯示哪一半，並把選擇記在 localStorage 的 oms_lang。
 *
 * 一旦有了 /en/ 獨立網址，這套機制會產生兩個**畫面全空**的失效路徑：
 *   ① 英文頁的 .zh-only 已在建置期被剝掉，讀者按 🌐 切回中文 → 什麼都不剩
 *   ② 更糟：載入時 `if (l) { dataset.lang = l }` 會讓 localStorage 覆蓋網址，
 *      任何曾在這批頁按過切換的回訪者，一進 /en/ 就是空白頁，不必按任何東西
 *
 * 所以兩件事一起做：停用 localStorage 對語言的記憶（主題不受影響），
 * 並把按鈕換成指向另一個語言網址的 <a>。
 *
 * 這與第九階段對 sponsor 頁的判斷一致：**語言由網址決定**。
 * 那次的教訓是「對的抽象層改對了，下游全部跟著對」——這裡是同一個抽象層。
 */
if (localized) {
  const LANG_MEMORY = "localStorage.getItem('oms_lang')";
  if (!fragment.includes(LANG_MEMORY)) {
    throw new Error(`${pageKey}：找不到 ${LANG_MEMORY}，語言記憶可能改了寫法——請確認後更新這裡`);
  }
  /* 換成 null，讓 `if (l)` 永遠不成立。主題的 oms_theme 不動。 */
  fragment = fragment.replace(LANG_MEMORY, 'null /* 語言由網址決定，見 StaticPageContent */');

  /* 英文路由：站內連結改指英文版（有的話）。
     不做的話，英文子頁的麵包屑會把讀者送回中文樞紐——樞紐頁遷好了，
     子頁卻連不回來，英文區等於少了一層。

     判準走 localeHref()，沒有英文版的路徑會原樣通過，所以這裡不需要
     維護任何清單，也不會產生指向不存在網址的連結。
     刻意不動帶 # 或 ? 的連結：那些是頁內錨點與查詢參數，換前綴沒有意義。

     ⚠ **順序有意義：這一段必須在下面插入語言鈕之前。**
     反過來的話，這個改寫會把剛插入的 <a id="langBtn"> 也一起改掉——
     它的 href 是「另一個語言」的網址，被改成英文版就等於指向自己，
     按下去留在原地。實測踩過一次，而 verifyI18nHreflang 攔不住：
     那個守衛驗的是 <link rel="alternate"> 標籤，不是這顆按鈕。 */
  if (isEn) {
    fragment = fragment.replace(
      /href="(\/[^"#?]*)"/g,
      (_m, p: string) => `href="${localeHref(p, 'en')}"`,
    );
  }

  const BTN = /<button[^>]*id="langBtn"[^>]*>[^<]*<\/button>/;
  if (!BTN.test(fragment)) {
    throw new Error(`${pageKey}：找不到 id="langBtn" 的按鈕，語言鈕可能改了寫法——請確認後更新這裡`);
  }
  const target = isEn ? localized.zhPath : localized.enPath;
  const label = isEn ? '🌐 中' : '🌐 EN';
  fragment = fragment.replace(
    BTN,
    `<a class="icon-btn" id="langBtn" href="${target}" hreflang="${isEn ? 'zh-TW' : 'en'}">${label}</a>`,
  );
}
---

<Fragment set:html={fragment} />
