---
/*
 * Tour — 首頁的聚光燈導覽（spotlight onboarding）。
 *
 * 只掛在首頁：所有步驟的目標都是首頁的 hero 與導覽列元素，
 * 在其他頁面執行會指向不存在的節點。
 *
 * 設計限制（依站上現況）：
 * - 站內最大 z-index 是 1000（贊助 modal），所以 tour 圖層從 9000 起跳。
 * - 主題完全走站上的 CSS 變數，深/淺色自動跟隨，不另外定義顏色。
 * - 雙語沿用 <html data-lang> 與 langchange 事件，導覽中途切語言會即時重寫文案。
 * - DOM 由 JS 動態建立，Astro 的 scoped style 不會加上 hash 屬性，故用 is:global。
 */
---

<button type="button" id="tour-open" class="tt-help" aria-label="網站導覽 / Site tour">
  <span aria-hidden="true">?</span>
</button>

<style is:global>
  .tt-help {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 900; /* 低於贊助 modal(1000) 與 tour(9000+) */
    width: 44px;   /* WCAG 2.5.5 建議的最小觸控目標 */
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text-muted);
    font-size: 1rem;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    box-shadow: var(--card-shadow-hover);
    transition: color 0.15s, border-color 0.15s, transform 0.15s;
  }
  .tt-help:hover { color: var(--color-accent); border-color: var(--color-accent); transform: translateY(-2px); }
  .tt-help:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* blocker：吃掉導覽期間的所有點擊，避免頁面狀態漂移 */
  .tt-block {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: transparent;
  }

  /* spotlight：用超大 box-shadow 打出一個真正的洞，目標保留原本顏色 */
  .tt-spot {
    position: fixed;
    z-index: 9001;
    border-radius: 8px;
    box-shadow: 0 0 0 200vmax rgba(0, 0, 0, 0.62),
                0 0 0 2px var(--color-accent),
                0 0 0 4px rgba(255, 255, 255, 0.55); /* 亮度光暈：不靠色相也能辨識邊緣 */
    pointer-events: auto;
    transition: top 0.28s cubic-bezier(.3,.8,.3,1), left 0.28s cubic-bezier(.3,.8,.3,1),
                width 0.28s cubic-bezier(.3,.8,.3,1), height 0.28s cubic-bezier(.3,.8,.3,1);
  }
  .tt-spot.tt-nofly { transition: none; }
  .tt-spot.tt-hidden { box-shadow: 0 0 0 200vmax rgba(0, 0, 0, 0.62); }

  .tt-card {
    position: fixed;
    z-index: 9002;
    width: min(320px, calc(100vw - 32px));
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    padding: 1rem 1.1rem 0.9rem;
    transition: top 0.28s cubic-bezier(.3,.8,.3,1), left 0.28s cubic-bezier(.3,.8,.3,1);
  }
  .tt-card.tt-nofly { transition: none; }

  .tt-arrow {
    position: fixed;
    z-index: 9003;
    width: 12px;
    height: 12px;
    background: var(--color-bg);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    transform: rotate(45deg);
  }
  .tt-arrow.tt-hidden { display: none; }

  .tt-head { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; }
  .tt-ico { font-size: 1.1rem; line-height: 1; }
  .tt-count {
    margin-left: auto;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .tt-title { font-size: 0.98rem; font-weight: 700; line-height: 1.35; }
  .tt-body { font-size: 0.84rem; color: var(--color-text-muted); line-height: 1.65; margin-bottom: 0.9rem; }

  .tt-actions { display: flex; align-items: center; gap: 0.5rem; }
  .tt-btn {
    font-family: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }
  .tt-btn:hover { color: var(--color-text); border-color: var(--color-text-muted); }
  .tt-btn-primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
    margin-left: auto;
  }
  .tt-btn-primary:hover { color: #fff; filter: brightness(1.08); }
  .tt-btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .tt-skip { font-size: 0.76rem; padding: 0.4rem 0.5rem; border-color: transparent; }

  @media (prefers-reduced-motion: reduce) {
    .tt-spot, .tt-card { transition: none !important; }
  }
</style>

<script>
  interface Step {
    sel: string | null;
    ico: string;
    zh: [string, string];
    en: [string, string];
    pad?: number;
  }

  const STEPS: Step[] = [
    {
      sel: null, ico: '👋',
      zh: ['歡迎來到 Matt 的個人網站', '這裡收錄我的演講、競賽培訓、side project 與文章。花 30 秒帶你看過主要區塊，隨時可以按 Esc 離開。'],
      en: ["Welcome to Matt's site", 'Talks, coaching records, side projects and writing all live here. A 30-second tour of the main areas — press Esc to leave anytime.'],
    },
    {
      sel: '.hero-text h1', ico: '🙋',
      zh: ['我是誰', '葉淨維 Ching-Wei (Matt) Ye — 職能治療師、NTU 博士候選人，也做簡報教育與研究溝通。'],
      en: ['Who I am', 'Ching-Wei (Matt) Ye — occupational therapist, PhD candidate at NTU, working on presentation education and research communication.'],
    },
    {
      sel: '.hero-tags', ico: '🏷️',
      zh: ['一眼看懂背景', '這幾個標籤是最快的自我介紹：研究領域、演講場次、學位進度與競賽成績。'],
      en: ['The short version', 'These tags are the fastest introduction: research field, talks delivered, degree progress and competition results.'],
    },
    {
      sel: 'nav a[href="/speeches"]', ico: '🎤',
      zh: ['演講', '2020 年至今 150+ 場的完整紀錄，可依主題、對象、線上／實體篩選，也有合作單位排行榜。'],
      en: ['Speeches', 'Every talk since 2020 — filter by topic, audience and format, plus a leaderboard of partner organizations.'],
    },
    {
      sel: 'nav a[href="/coaching"]', ico: '🏆',
      zh: ['培訓', '我陪學生打competition的成果：MAIC、Falling Walls Lab、ATCC 冠軍隊伍，還有他們自己寫的回饋。'],
      en: ['Coaching', 'Competition results from teams I coached — MAIC, Falling Walls Lab, and the ATCC national champions, with their own feedback.'],
    },
    {
      sel: 'nav a[href="/projects"]', ico: '🛠️',
      zh: ['專案', '可以實際操作的小工具，例如以文獻為基礎的體態管理計算機，以及 One More Step 學習筆記。'],
      en: ['Projects', 'Hands-on tools such as the literature-based body composition calculator, plus the One More Step learning notes.'],
    },
    {
      sel: 'nav a[href="/writing"]', ico: '✍️',
      zh: ['寫作', '投資專欄、硬核簡報系列與隨筆都在這裡，可以依系列篩選。'],
      en: ['Writing', 'The investing column, the presentation series and essays — filterable by series.'],
    },
    {
      sel: '.hero-actions', ico: '📮',
      zh: ['找我合作 / 請我喝咖啡', '左邊是合作洽詢，右邊金色的是贊助入口，支援台幣與美金。'],
      en: ['Work with me / buy me a coffee', 'On the left is the contact button; the gold one opens sponsorship, in TWD or USD.'],
    },
    {
      sel: '#lang-toggle', ico: '🌐', pad: 8,
      zh: ['中英切換與深色模式', '整站可以切換中英文，旁邊的圖示切換深色／淺色，設定會記住。'],
      en: ['Language & dark mode', 'The whole site switches between Chinese and English; the icon beside it toggles dark mode. Both are remembered.'],
    },
    {
      sel: null, ico: '🎉',
      zh: ['就這樣！', '想再看一次的話，右下角的「?」隨時可以重新開始。'],
      en: ["That's it", 'Want to see it again? The "?" button in the bottom-right restarts the tour anytime.'],
    },
  ];

  const KEY = 'tour_seen';
  const lang = () => (document.documentElement.getAttribute('data-lang') === 'en' ? 'en' : 'zh');
  const track = (n: string, p: Record<string, unknown> = {}) => {
    try { (window as any).gtag?.('event', n, p); } catch (e) {}
  };

  let steps: Step[] = [];
  let idx = 0;
  let raf = 0;
  let live = false;
  let els: Record<string, HTMLElement> = {};
  let lastRect = '';

  const reduced = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* 只保留「存在且真的看得見」的步驟；計數在過濾後才算，避免出現指不到東西的 n/total */
  function resolve(): Step[] {
    return STEPS.filter(s => {
      if (!s.sel) return true;
      const el = document.querySelector(s.sel) as HTMLElement | null;
      if (!el) return false;
      const r = el.getBoundingClientRect();
      return r.width > 4 && r.height > 4;
    });
  }

  function build() {
    const mk = (cls: string, tag = 'div') => {
      const e = document.createElement(tag);
      e.className = cls;
      document.body.appendChild(e);
      return e as HTMLElement;
    };
    els.block = mk('tt-block');
    els.spot = mk('tt-spot');
    els.arrow = mk('tt-arrow');
    const card = mk('tt-card');
    card.setAttribute('role', 'dialog');
    card.setAttribute('aria-modal', 'true');
    card.setAttribute('aria-live', 'polite');
    card.innerHTML =
      '<div class="tt-head"><span class="tt-ico"></span><span class="tt-title"></span><span class="tt-count"></span></div>' +
      '<p class="tt-body"></p>' +
      '<div class="tt-actions">' +
      '<button type="button" class="tt-btn tt-skip"></button>' +
      '<button type="button" class="tt-btn tt-prev"></button>' +
      '<button type="button" class="tt-btn tt-btn-primary tt-next"></button>' +
      '</div>';
    els.card = card;
    els.ico = card.querySelector('.tt-ico') as HTMLElement;
    els.title = card.querySelector('.tt-title') as HTMLElement;
    els.count = card.querySelector('.tt-count') as HTMLElement;
    els.body = card.querySelector('.tt-body') as HTMLElement;
    els.skip = card.querySelector('.tt-skip') as HTMLElement;
    els.prev = card.querySelector('.tt-prev') as HTMLElement;
    els.next = card.querySelector('.tt-next') as HTMLElement;

    els.skip.addEventListener('click', () => end('skip'));
    els.prev.addEventListener('click', () => go(idx - 1));
    els.next.addEventListener('click', () => (idx >= steps.length - 1 ? end('done') : go(idx + 1)));
    els.block.addEventListener('click', e => e.stopPropagation());
  }

  function place(first: boolean) {
    const s = steps[idx];
    const card = els.card, spot = els.spot, arrow = els.arrow;
    const vw = window.innerWidth, vh = window.innerHeight;
    const cw = card.offsetWidth, ch = card.offsetHeight;
    const target = s.sel ? (document.querySelector(s.sel) as HTMLElement | null) : null;

    if (!target) {
      spot.classList.add('tt-hidden');
      spot.style.cssText += ';top:50%;left:50%;width:0;height:0;';
      arrow.classList.add('tt-hidden');
      card.style.top = Math.round((vh - ch) / 2) + 'px';
      card.style.left = Math.round((vw - cw) / 2) + 'px';
      return;
    }

    spot.classList.remove('tt-hidden');
    const r = target.getBoundingClientRect();
    const pad = s.pad ?? 6;
    const t = Math.max(0, r.top - pad), l = Math.max(0, r.left - pad);
    const w = Math.min(vw, r.width + pad * 2), h = Math.min(vh, r.height + pad * 2);
    spot.style.top = t + 'px';
    spot.style.left = l + 'px';
    spot.style.width = w + 'px';
    spot.style.height = h + 'px';
    const br = getComputedStyle(target).borderRadius;
    spot.style.borderRadius = br && br !== '0px' ? br : '8px';

    /* 挑一個不會蓋住聚光燈的邊：手機優先上下，桌面優先左右 */
    const gap = 14;
    const mobile = vw < 720;
    const order = mobile ? ['bottom', 'top', 'right', 'left'] : ['right', 'left', 'bottom', 'top'];
    const fits: Record<string, boolean> = {
      right: vw - (l + w) - gap >= cw,
      left: l - gap >= cw,
      bottom: vh - (t + h) - gap >= ch,
      top: t - gap >= ch,
    };
    const side = order.find(o => fits[o]) || 'bottom';

    let ct: number, cl: number;
    if (side === 'right') { cl = l + w + gap; ct = t + h / 2 - ch / 2; }
    else if (side === 'left') { cl = l - gap - cw; ct = t + h / 2 - ch / 2; }
    else if (side === 'bottom') { ct = t + h + gap; cl = l + w / 2 - cw / 2; }
    else { ct = t - gap - ch; cl = l + w / 2 - cw / 2; }

    ct = Math.max(8, Math.min(ct, vh - ch - 8));
    cl = Math.max(8, Math.min(cl, vw - cw - 8));
    card.style.top = Math.round(ct) + 'px';
    card.style.left = Math.round(cl) + 'px';

    /* 箭頭指向目標中心，但夾在卡片邊緣內側，避免掛在圓角外 */
    const overlaps = !(ct + ch < t || ct > t + h || cl + cw < l || cl > l + w);
    if (overlaps) { arrow.classList.add('tt-hidden'); return; }
    arrow.classList.remove('tt-hidden');
    const cx = l + w / 2, cy = t + h / 2;
    if (side === 'right' || side === 'left') {
      const y = Math.max(ct + 14, Math.min(cy, ct + ch - 14));
      arrow.style.top = y - 6 + 'px';
      arrow.style.left = (side === 'right' ? cl - 6 : cl + cw - 6) + 'px';
      arrow.style.transform = 'rotate(' + (side === 'right' ? '-45' : '135') + 'deg)';
    } else {
      const x = Math.max(cl + 14, Math.min(cx, cl + cw - 14));
      arrow.style.left = x - 6 + 'px';
      arrow.style.top = (side === 'bottom' ? ct - 6 : ct + ch - 6) + 'px';
      arrow.style.transform = 'rotate(' + (side === 'bottom' ? '45' : '-135') + 'deg)';
    }
  }

  function paint() {
    const s = steps[idx];
    const L = lang();
    const [title, body] = L === 'en' ? s.en : s.zh;
    els.ico.textContent = s.ico;
    els.title.textContent = title;
    els.body.textContent = body;
    els.count.textContent = idx + 1 + '/' + steps.length;
    els.skip.textContent = L === 'en' ? 'Skip' : '略過';
    els.prev.textContent = L === 'en' ? 'Back' : '上一步';
    els.next.textContent = idx >= steps.length - 1 ? (L === 'en' ? 'Done' : '完成') : (L === 'en' ? 'Next' : '下一步');
    els.prev.style.display = idx === 0 ? 'none' : '';
  }

  function go(n: number) {
    idx = Math.max(0, Math.min(n, steps.length - 1));
    const s = steps[idx];
    if (s.sel) {
      const el = document.querySelector(s.sel) as HTMLElement | null;
      el?.scrollIntoView({ block: 'center', behavior: reduced() ? 'auto' : 'smooth' });
    }
    paint();
    place(false);
    els.next.focus();
    track('tour_step', { step: idx + 1, total: steps.length });
  }

  function loop() {
    if (!live) return;
    const s = steps[idx];
    if (s?.sel) {
      const el = document.querySelector(s.sel) as HTMLElement | null;
      if (el) {
        const r = el.getBoundingClientRect();
        const sig = [r.top, r.left, r.width, r.height].map(v => Math.round(v * 2)).join(',');
        if (sig !== lastRect) { lastRect = sig; place(false); }
      }
    }
    raf = requestAnimationFrame(loop);
  }

  function onKey(e: KeyboardEvent) {
    if (!live) return;
    if (e.key === 'Escape') { e.preventDefault(); end('skip'); }
    else if (e.key === 'ArrowRight' || e.key === 'Enter') {
      e.preventDefault();
      idx >= steps.length - 1 ? end('done') : go(idx + 1);
    } else if (e.key === 'ArrowLeft') { e.preventDefault(); go(idx - 1); }
  }

  function onLang() { if (live) { paint(); place(false); } }

  /* 跨越響應式斷點時 DOM 佈局會變，乾淨收掉比硬撐好 */
  const mq = window.matchMedia('(max-width: 720px)');
  function onBreak() { if (live) end('skip'); }

  function start() {
    /* 若上一輪還沒收乾淨就重入，先拆掉監聽與 rAF 再重來；
       這裡不呼叫 end()，否則會誤記一次 tour_skip 並提早寫入 tour_seen */
    if (live) teardown();
    steps = resolve();
    if (!steps.length) return;
    idx = 0;
    live = true;
    if (!els.card) build();
    [els.block, els.spot, els.arrow, els.card].forEach(e => (e.style.display = ''));
    els.spot.classList.add('tt-nofly');
    els.card.classList.add('tt-nofly');
    paint();
    place(true);
    requestAnimationFrame(() => {
      els.spot.classList.remove('tt-nofly');
      els.card.classList.remove('tt-nofly');
    });
    els.next.focus();
    document.addEventListener('keydown', onKey, true);
    window.addEventListener('langchange', onLang);
    mq.addEventListener('change', onBreak);
    raf = requestAnimationFrame(loop);
    track('tour_start', { total: steps.length });
  }

  /* 只拆掉執行中的狀態（監聽、rAF、圖層），不寫 storage、不送分析事件 */
  function teardown() {
    live = false;
    cancelAnimationFrame(raf);
    lastRect = '';
    document.removeEventListener('keydown', onKey, true);
    window.removeEventListener('langchange', onLang);
    mq.removeEventListener('change', onBreak);
    [els.block, els.spot, els.arrow, els.card].forEach(e => e && (e.style.display = 'none'));
  }

  function end(how: 'done' | 'skip') {
    if (!live) return;
    teardown();
    try { localStorage.setItem(KEY, '1'); } catch (e) {}
    track(how === 'done' ? 'tour_done' : 'tour_skip', { step: idx + 1, total: steps.length });
    (document.getElementById('tour-open') as HTMLElement | null)?.focus();
  }

  document.getElementById('tour-open')?.addEventListener('click', () => start());

  /* 首訪自動開場；帶著 query/hash 進來的（分享連結、錨點）不打擾 */
  function maybeAuto() {
    let seen = '1';
    try { seen = localStorage.getItem(KEY) || ''; } catch (e) { seen = '1'; }
    if (seen) return;
    if (location.search || location.hash) return;
    setTimeout(start, 900);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', maybeAuto);
  } else {
    maybeAuto();
  }
</script>
